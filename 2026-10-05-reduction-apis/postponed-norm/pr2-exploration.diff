+/// Norm reduction as a single fold over the given axes (`TOut` is the real
+/// float associated with `T`).
+///
+/// Vector/matrix interpretation of [`NormOrd`] (axis order, two-stage matrix
+/// ±1/±Inf norms) is resolved by the caller (`rt::norm` family); the device
+/// only maps `ord` onto fold closures.
+#[allow(clippy::type_complexity)]
+pub trait OpNormAPI<T, D>
+where
+    D: DimAPI,
+    Self: DeviceAPI<T> + DeviceAPI<Self::TOut>,
+{
+    type TOut;
+
+    fn norm_all(&self, a: &<Self as DeviceRawAPI<T>>::Raw, la: &Layout<D>, ord: &NormOrd) -> Result<Self::TOut>;
+    fn norm_axes(
+        &self,
+        a: &<Self as DeviceRawAPI<T>>::Raw,
+        la: &Layout<D>,
+        axes: &[isize],
+        ord: &NormOrd,
+    ) -> Result<(Storage<DataOwned<<Self as DeviceRawAPI<Self::TOut>>::Raw>, Self::TOut, Self>, Layout<IxD>)>;
+
+    /// Two-stage matrix ±1/±Inf norm: sum of absolute values along `sum_axis`,
+    /// then maximum (`is_max`) or minimum over `cmp_axis` (axis indices count
+    /// from the back; adjusted by the device after the first stage). Empty
+    /// max stage yields zero (NumPy `max(initial=0)` semantics).
+    fn norm_matrix_cmp_axes(
+        &self,
+        a: &<Self as DeviceRawAPI<T>>::Raw,
+        la: &Layout<D>,
+        sum_axis: isize,
+        cmp_axis: isize,
+        is_max: bool,
+    ) -> Result<(Storage<DataOwned<<Self as DeviceRawAPI<Self::TOut>>::Raw>, Self::TOut, Self>, Layout<IxD>)>;
+}
+
+/// Custom user reduction over generic closures (init / fold / combine /
+/// finalize); the accumulator `TS` and output `TO` are both free.
+///
+/// `combine` must be associative; within one output cell the input order is
+/// sequential (row-major traversal), but the tree shape of `combine` is
+/// device-defined (e.g. parallel chunking on the rayon device).
+#[allow(clippy::type_complexity)]
+pub trait OpReduceCustomAPI<T, TS, TO, D>
+where
+    D: DimAPI,
+    Self: DeviceAPI<T> + DeviceAPI<TO>,
+{
+    fn reduce_all_custom<FI, FF, FC, FO>(
+        &self,
+        a: &<Self as DeviceRawAPI<T>>::Raw,
+        la: &Layout<D>,
+        f_init: FI,
+        f: FF,
+        f_sum: FC,
+        f_out: FO,
+    ) -> Result<TO>
+    where
+        TS: Clone,
+        FI: Fn() -> TS + Send + Sync,
+        FF: Fn(TS, T) -> TS + Send + Sync,
+        FC: Fn(TS, TS) -> TS + Send + Sync,
+        FO: Fn(TS) -> TO + Send + Sync;
+
+    fn reduce_axes_custom<FI, FF, FC, FO>(
+        &self,
+        a: &<Self as DeviceRawAPI<T>>::Raw,
+        la: &Layout<D>,
+        axes: &[isize],
+        f_init: FI,
+        f: FF,
+        f_sum: FC,
+        f_out: FO,
+    ) -> Result<(Storage<DataOwned<<Self as DeviceRawAPI<TO>>::Raw>, TO, Self>, Layout<IxD>)>
+    where
+        TS: Clone,
+        TO: Clone,
+        FI: Fn() -> TS + Send + Sync,
+        FF: Fn(TS, T) -> TS + Send + Sync,
+        FC: Fn(TS, TS) -> TS + Send + Sync,
+        FO: Fn(TS) -> TO + Send + Sync;
+}
