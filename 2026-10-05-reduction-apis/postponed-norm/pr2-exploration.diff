+/// Computes the matrix or vector norm of the whole input (NumPy
+/// `numpy.linalg.norm` with `axis=None`).
+///
+/// The norm order `ord` is an enforced parameter; see [`NormOrd`] for the
+/// ord table and its numeric/string conversions. With no axes given, a 1-D
+/// input takes vector norms and a 2-D input takes matrix norms (NumPy's
+/// `axis=None` semantics; higher-rank inputs require explicit axes via
+/// [`norm_axes`]). One axis gives vector norms, two axes give matrix norms
+/// (axis order matters for ord=±1/±inf, NumPy semantics). The output dtype
+/// is the real float associated with the input (`T::Real`; complex input
+/// yields real output).
+///
+/// This function behaves identically under [`RowMajor`] and [`ColMajor`] device default orders.
+///
+/// # Parameters
+///
+/// - `tensor`: [`&TensorAny<R, T, B, D>`](TensorAny), the input; float or complex float.
+/// - `ord`: norm order; anything converting into [`NormOrd`] (floats and integers like `2.0`/`-1`,
+///   [`NormOrd`] itself, or strings like `"l1"`/`"fro"`).
+///
+/// # Returns
+///
+/// The norm as a scalar of type `B::TOut` (the input's associated real float type).
+///
+/// # Examples
+///
+/// ```rust
+/// # use rstsr::prelude::*;
+/// # let mut device = DeviceCpu::default();
+/// # device.set_default_order(RowMajor);
+/// let v = rt::tensor_from_nested!([3.0, 4.0], &device);
+/// println!("{}", rt::norm(&v, 2.0));
+/// // 5
+/// # assert_eq!(rt::norm(&v, 2.0), 5.0);
+/// ```
+///
+/// Matrix norms on 2-D input, with the string ord spelling:
+///
+/// ```rust
+/// # use rstsr::prelude::*;
+/// # let mut device = DeviceCpu::default();
+/// # device.set_default_order(RowMajor);
+/// let a = rt::tensor_from_nested!([[1.0, 2.0], [3.0, 4.0]], &device);
+/// println!("{}", rt::norm(&a, "fro"));
+/// // 5.477225575051661
+/// println!("{}", rt::norm(&a, 1.0));
+/// // 6
+/// # assert_eq!(rt::norm(&a, "fro"), 5.477225575051661);
+/// # assert_eq!(rt::norm(&a, 1.0), 6.0);
+/// ```
+///
+/// # Notes of API accordance
+///
+/// - NumPy: `norm(x, ord=None, axis=None, keepdims=False)` ([`numpy.linalg.norm`](https://numpy.org/doc/stable/reference/generated/numpy.linalg.norm.html));
+///   the ord table, axis-tuple order (ord=±1 reduces `axis[0]` first) and the string ords follow
+///   NumPy, except `ord` is an enforced positional here (NumPy's `ord=None` default corresponds to
+///   passing `2`; the `ord=None` raveled 2-norm of an n-D array maps to [`l2_norm`]). The nuclear
+///   order (`'nuc'`) is excluded rather than raising at fold time (SVD-dependent).
+/// - Integer input is not promoted (NumPy casts to float first); convert with an explicit cast,
+///   same convention as [`l2_norm`].
+///
+/// # Panics
+///
+/// - Panics if the input dtype is not a float or complex float.
+/// - Panics for invalid ord/axes combinations (NumPy raises `ValueError` for the same inputs, e.g.
+///   `P(_)`/`Zero` with two axes, or `"fro"` on a single axis).
+/// - Empty inputs with `NegInf` return `inf` instead of raising (RSTSR's zero-size reduction
+///   semantics).
+///
+/// For a fallible version, use [`norm_f`].
+///
+/// # See also
+///
+/// ## Similar function from other crates/libraries
+///
+/// - NumPy: [`numpy.linalg.norm`](https://numpy.org/doc/stable/reference/generated/numpy.linalg.norm.html)
+///
+/// ## Related functions in RSTSR
+///
+/// - [`l2_norm`]: the 2-norm fast path (same fold, no ord dispatch)
+///
+/// ## Variants of this function
+///
+/// - [`norm_all`]: alias of this function
+/// - [`norm_axes`], [`norm_with_args`]: axes / [`ReduceArgs`] forms
+/// - [`norm_f`]: fallible version
+/// - Associated methods on `TensorAny`: `.norm(…)`, `.norm_f(…)`, `.norm_axes(…)`,
+///   `.norm_with_args(…)` and their `_f` twins
+pub fn norm_f<T, B, D>(
+    tensor: impl TensorViewAPI<Type = T, Backend = B, Dim = D>,
+    ord: impl TryInto<NormOrd, Error: Into<Error>>,
+) -> Result<B::TOut>
+where
+    D: DimAPI,
+    B: OpNormAPI<T, IxD> + DeviceCreationAnyAPI<B::TOut>,
+    B::TOut: Clone,
+{
+    let val = norm_with_args_f(tensor, ord, ReduceArgs::default())?;
+    Ok(val.to_scalar())
+}
