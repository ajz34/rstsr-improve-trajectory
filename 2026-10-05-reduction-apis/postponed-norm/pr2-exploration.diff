+        let (inter, layout_1) = norm_axes_vec_cpu_rayon(a, la, &[sum_axis], &NormOrd::One, pool)?;
+        let cmp_axis = if cmp_axis > sum_axis { cmp_axis - 1 } else { cmp_axis };
+        let (out, layout_out) = reduce_axes_cpu_rayon(
+            &inter,
