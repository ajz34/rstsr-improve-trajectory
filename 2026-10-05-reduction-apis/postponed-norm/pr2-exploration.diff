+                    } else {
+                        acc2
+                    }
+                } else if Float::is_nan(acc1) || acc1 < acc2 {
+                    acc1
+                } else {
+                    acc2
+                }
+            },
+            |acc| acc,
+            pool,
+        )?;
+        Ok((Storage::new(out.into(), self.clone()), layout_out))
