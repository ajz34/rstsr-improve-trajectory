+/// Norm fold dispatched per ord onto the generic reduction kernels.
+fn norm_axes_vec_cpu_serial<T, D>(
+    a: &[T],
+    la: &Layout<D>,
+    axes: &[isize],
+    ord: &NormOrd,
+) -> Result<(Vec<T::Real>, Layout<IxD>)>
+where
+    T: Clone + ComplexFloat + FromPrimitive,
+    T::Real: Clone + Float + FromPrimitive,
+    D: DimAPI,
+{
+    type R<T> = <T as ComplexFloat>::Real;
+
+    let f_sum = |acc1: R<T>, acc2: R<T>| acc1 + acc2;
+    match ord {
+        NormOrd::One => {
+            let f_init = || R::<T>::zero();
+            let f = |acc: R<T>, x: T| acc + x.abs();
+            reduce_axes_cpu_serial(a, &la.to_dim()?, axes, f_init, f, f_sum, |acc| acc)
+        },
+        NormOrd::Two | NormOrd::Fro => {
+            let f_init = || R::<T>::zero();
+            let f = |acc: R<T>, x: T| acc + (x * x.conj()).re();
+            reduce_axes_cpu_serial(a, &la.to_dim()?, axes, f_init, f, f_sum, ComplexFloat::sqrt)
+        },
+        NormOrd::Inf => {
+            let f_init = || R::<T>::zero();
+            let f = |acc: R<T>, x: T| {
+                let r = x.abs();
+                if Float::is_nan(r) || r > acc {
+                    r
+                } else {
+                    acc
+                }
+            };
+            let f_sum = |acc1: R<T>, acc2: R<T>| if Float::is_nan(acc1) || acc1 > acc2 { acc1 } else { acc2 };
+            reduce_axes_cpu_serial(a, &la.to_dim()?, axes, f_init, f, f_sum, |acc| acc)
+        },
+        NormOrd::NegInf => {
+            let f_init = || R::<T>::infinity();
+            let f = |acc: R<T>, x: T| {
+                let r = x.abs();
+                if Float::is_nan(r) || r < acc {
+                    r
+                } else {
+                    acc
+                }
+            };
+            let f_sum = |acc1: R<T>, acc2: R<T>| if Float::is_nan(acc1) || acc1 < acc2 { acc1 } else { acc2 };
+            reduce_axes_cpu_serial(a, &la.to_dim()?, axes, f_init, f, f_sum, |acc| acc)
+        },
+        NormOrd::Zero => {
+            let f_init = || R::<T>::zero();
+            let f = |acc: R<T>, x: T| {
+                if x.re() != R::<T>::zero() || x.im() != R::<T>::zero() {
+                    acc + R::<T>::one()
+                } else {
+                    acc
+                }
+            };
+            reduce_axes_cpu_serial(a, &la.to_dim()?, axes, f_init, f, f_sum, |acc| acc)
+        },
+        NormOrd::NegOne => {
+            let f_init = || R::<T>::zero();
+            let f = |acc: R<T>, x: T| acc + R::<T>::one() / x.abs();
+            reduce_axes_cpu_serial(a, &la.to_dim()?, axes, f_init, f, f_sum, Float::recip)
+        },
+        NormOrd::NegTwo => {
+            let f_init = || R::<T>::zero();
+            let f = |acc: R<T>, x: T| acc + R::<T>::one() / (x * x.conj()).re();
+            reduce_axes_cpu_serial(a, &la.to_dim()?, axes, f_init, f, f_sum, |acc| {
+                Float::recip(ComplexFloat::sqrt(acc))
+            })
+        },
+        NormOrd::P(p) => {
+            let p_f = <R<T> as FromPrimitive>::from_f64(*p).unwrap();
+            let p_inv = <R<T> as FromPrimitive>::from_f64(1.0 / *p).unwrap();
+            let f_init = || R::<T>::zero();
+            let f = move |acc: R<T>, x: T| acc + Float::powf(x.abs(), p_f);
+            let f_out = move |acc: R<T>| Float::powf(acc, p_inv);
+            reduce_axes_cpu_serial(a, &la.to_dim()?, axes, f_init, f, f_sum, f_out)
+        },
+    }
+}
+
+impl<T, D> OpNormAPI<T, D> for DeviceCpuSerial
+where
+    T: Clone + ComplexFloat + FromPrimitive,
+    T::Real: Clone + Float + FromPrimitive,
+    D: DimAPI,
+{
+    type TOut = T::Real;
+
+    fn norm_all(&self, a: &Vec<T>, la: &Layout<D>, ord: &NormOrd) -> Result<T::Real> {
+        let axes: Vec<isize> = (0..la.ndim() as isize).collect();
+        let (out, _) = norm_axes_vec_cpu_serial(a, la, &axes, ord)?;
+        Ok(out[0])
+    }
+
+    fn norm_axes(
+        &self,
+        a: &Vec<T>,
+        la: &Layout<D>,
+        axes: &[isize],
+        ord: &NormOrd,
+    ) -> Result<(Storage<DataOwned<Vec<T::Real>>, T::Real, Self>, Layout<IxD>)> {
+        let (out, layout_out) = norm_axes_vec_cpu_serial(a, la, axes, ord)?;
+        Ok((Storage::new(out.into(), self.clone()), layout_out))
+    }
+
+    fn norm_matrix_cmp_axes(
+        &self,
+        a: &Vec<T>,
+        la: &Layout<D>,
+        sum_axis: isize,
+        cmp_axis: isize,
+        is_max: bool,
+    ) -> Result<(Storage<DataOwned<Vec<T::Real>>, T::Real, Self>, Layout<IxD>)> {
+        type R<T> = <T as ComplexFloat>::Real;
+
+        // stage 1: sum of absolute values along `sum_axis`
+        let (inter, layout_1) = norm_axes_vec_cpu_serial(a, la, &[sum_axis], &NormOrd::One)?;
+        // stage 2: max/min over `cmp_axis` of the remaining layout
+        let cmp_axis = if cmp_axis > sum_axis { cmp_axis - 1 } else { cmp_axis };
+        let (out, layout_out) = reduce_axes_cpu_serial(
+            &inter,
+            &layout_1,
+            &[cmp_axis],
+            || {
+                if is_max {
+                    R::<T>::zero()
+                } else {
+                    R::<T>::infinity()
+                }
+            },
+            |acc, x: T::Real| {
+                if is_max {
+                    if Float::is_nan(x) || x > acc {
+                        x
+                    } else {
+                        acc
+                    }
+                } else if Float::is_nan(x) || x < acc {
+                    x
+                } else {
+                    acc
+                }
+            },
+            |acc1, acc2| {
+                if is_max {
+                    if Float::is_nan(acc1) || acc1 > acc2 {
+                        acc1
+                    } else {
+                        acc2
+                    }
+                } else if Float::is_nan(acc1) || acc1 < acc2 {
+                    acc1
+                } else {
+                    acc2
+                }
+            },
+            |acc| acc,
+        )?;
+        Ok((Storage::new(out.into(), self.clone()), layout_out))
+    }
+}
+
+impl<T, TS, TO, D> OpReduceCustomAPI<T, TS, TO, D> for DeviceCpuSerial
+where
+    T: Clone,
+    TO: Clone,
+    D: DimAPI,
+{
+    fn reduce_all_custom<FI, FF, FC, FO>(
+        &self,
+        a: &Vec<T>,
+        la: &Layout<D>,
+        f_init: FI,
+        f: FF,
+        f_sum: FC,
+        f_out: FO,
+    ) -> Result<TO>
+    where
+        TS: Clone,
+        FI: Fn() -> TS + Send + Sync,
+        FF: Fn(TS, T) -> TS + Send + Sync,
+        FC: Fn(TS, TS) -> TS + Send + Sync,
+        FO: Fn(TS) -> TO + Send + Sync,
+    {
+        reduce_all_cpu_serial(a, la, f_init, f, f_sum, f_out)
+    }
+
+    fn reduce_axes_custom<FI, FF, FC, FO>(
+        &self,
+        a: &Vec<T>,
+        la: &Layout<D>,
+        axes: &[isize],
+        f_init: FI,
+        f: FF,
+        f_sum: FC,
+        f_out: FO,
+    ) -> Result<(Storage<DataOwned<Vec<TO>>, TO, Self>, Layout<IxD>)>
+    where
+        TS: Clone,
+        TO: Clone,
+        FI: Fn() -> TS + Send + Sync,
+        FF: Fn(TS, T) -> TS + Send + Sync,
+        FC: Fn(TS, TS) -> TS + Send + Sync,
+        FO: Fn(TS) -> TO + Send + Sync,
+    {
+        let (out, layout_out) = reduce_axes_cpu_serial(a, &la.to_dim()?, axes, f_init, f, f_sum, f_out)?;
+        Ok((Storage::new(out.into(), self.clone()), layout_out))
+    }
+}
