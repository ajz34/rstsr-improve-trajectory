+/// Norm order, following NumPy `numpy.linalg.norm`'s `ord` argument.
+///
+/// The same value may act as a vector norm or a matrix norm depending on the
+/// reduced axes (one axis: vector; two axes: matrix) - see [`norm`]. Values
+/// convert from floats and integers (`1.0` -> [`NormOrd::One`], `inf` ->
+/// [`NormOrd::Inf`], ...), and from strings via [`TryFrom`]: `"l1"`/`"L1"`
+/// ([`NormOrd::One`]), `"l2"`/`"L2"` ([`NormOrd::Two`]) and `"fro"`
+/// ([`NormOrd::Fro`]). The nuclear order (`"nuc"` in NumPy) is not provided:
+/// it requires SVD, and is excluded instead of raising at fold time.
+///
+/// # Examples
+///
+/// ```rust
+/// # use rstsr::prelude::*;
+/// # let mut device = DeviceCpu::default();
+/// # device.set_default_order(RowMajor);
+/// let v = rt::tensor_from_nested!([3.0, 4.0], &device);
+/// assert_eq!(rt::norm(&v, NormOrd::One), 7.0);
+/// assert_eq!(rt::norm(&v, 1.0), 7.0); // `f64` converts into `NormOrd`
+/// assert_eq!(rt::norm(&v, "l1"), 7.0); // string spellings
+/// ```
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub enum NormOrd {
+    /// `ord = 1` (also `"l1"`): sum of absolute values (matrices: maximum absolute column sum).
+    One,
+    /// `ord = 2` (also `"l2"`): Euclidean norm (matrices: largest singular value, not yet
+    /// supported).
+    Two,
+    /// `ord = inf`: maximum absolute value (matrices: maximum absolute row sum).
+    Inf,
+    /// `ord = -inf`: minimum absolute value (matrices: minimum absolute row sum).
+    NegInf,
+    /// `ord = 0`: number of nonzero elements (vectors only).
+    Zero,
+    /// `ord = -1`: `1 / sum(1/|x|)` (matrices: minimum absolute column sum).
+    NegOne,
+    /// `ord = -2`: `1 / sqrt(sum(1/|x|^2))` (matrices: smallest singular value, not yet supported).
+    NegTwo,
+    /// `ord = p`: `(sum(|x|^p))^(1/p)` for other `p` (vectors only).
+    P(f64),
+    /// Frobenius norm `sqrt(sum(|x|^2))` (also `"fro"`); identical to [`NormOrd::Two`] for vectors.
+    Fro,
+}
+
+fn norm_ord_from_f64(value: f64) -> NormOrd {
+    match value {
+        1.0 => NormOrd::One,
+        2.0 => NormOrd::Two,
+        f64::INFINITY => NormOrd::Inf,
+        f64::NEG_INFINITY => NormOrd::NegInf,
+        0.0 => NormOrd::Zero,
+        -1.0 => NormOrd::NegOne,
+        -2.0 => NormOrd::NegTwo,
+        v => NormOrd::P(v),
+    }
+}
+
+impl From<f64> for NormOrd {
+    fn from(value: f64) -> Self {
+        norm_ord_from_f64(value)
+    }
+}
+
+macro_rules! impl_norm_ord_from {
+    ($($t: ty),* $(,)?) => {$(
+        impl From<$t> for NormOrd {
+            fn from(value: $t) -> Self {
+                norm_ord_from_f64(value as f64)
+            }
+        }
+    )*};
+}
+
+impl_norm_ord_from!(f32, i8, i16, i32, i64, isize, u8, u16, u32, u64, usize);
+
+impl TryFrom<&str> for NormOrd {
+    type Error = Error;
+
+    fn try_from(value: &str) -> Result<Self> {
+        match value {
+            "l1" | "L1" => Ok(NormOrd::One),
+            "l2" | "L2" => Ok(NormOrd::Two),
+            "fro" => Ok(NormOrd::Fro),
+            _ => rstsr_raise!(InvalidValue, "invalid norm order string: {}", value),
+        }
+    }
+}
+
+impl TryFrom<String> for NormOrd {
+    type Error = Error;
+
+    fn try_from(value: String) -> Result<Self> {
+        NormOrd::try_from(value.as_str())
+    }
+}
+
