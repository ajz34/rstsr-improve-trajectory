+/// Classification + dispatch of NumPy norm semantics onto device fold calls;
+/// shared by the whole `norm` family. `axes` here is the resolved
+/// (normalized, order-preserving) axes list.
+fn norm_dispatch_axes_f<T, B>(
+    device: &B,
+    raw: &<B as DeviceRawAPI<T>>::Raw,
+    layout: &Layout<IxD>,
+    axes: &[isize],
+    ord: &NormOrd,
+    keepdims: bool,
+) -> Result<Tensor<B::TOut, B, IxD>>
+where
+    B: OpNormAPI<T, IxD> + DeviceCreationAnyAPI<B::TOut>,
+{
+    // NumPy reads a float `0.0` ord as the zero norm
+    let ord = match ord {
+        NormOrd::P(p) if *p == 0.0 => &NormOrd::Zero,
+        ord => ord,
+    };
+    let ndim = layout.ndim();
+
+    match axes.len() {
+        0 => rstsr_raise!(InvalidValue, "Improper number of dimensions to norm.")?,
+        1 => match ord {
+            NormOrd::Fro => rstsr_raise!(InvalidValue, "Invalid norm order for vectors.")?,
+            ord => {
+                let (storage, out_layout) = device.norm_axes(raw, layout, axes, ord)?;
+                let out_layout = reduce_layout_keepdims(out_layout, &AxesIndex::Vec(axes.to_vec()), ndim, keepdims)?;
+                Tensor::new_f(storage, out_layout)
+            },
+        },
+        2 => {
+            let (ax_0, ax_1) = (axes[0], axes[1]);
+            match ord {
+                // NumPy: `ord=None` (and `'fro'`) on two axes is the Frobenius norm
+                NormOrd::Fro => {
+                    let (storage, out_layout) = device.norm_axes(raw, layout, axes, &NormOrd::Two)?;
+                    let out_layout =
+                        reduce_layout_keepdims(out_layout, &AxesIndex::Vec(axes.to_vec()), ndim, keepdims)?;
+                    Tensor::new_f(storage, out_layout)
+                },
+                NormOrd::Two | NormOrd::NegTwo => {
+                    rstsr_raise!(UnImplemented, "matrix 2/-2 norms require SVD and are not supported yet")?
+                },
+                NormOrd::Zero | NormOrd::P(_) => rstsr_raise!(InvalidValue, "Invalid norm order for matrices.")?,
+                ord => {
+                    // NumPy: ord=±1 sums `axis[0]` then max/min over `axis[1]`;
+                    // ord=±inf sums `axis[1]` then max/min over `axis[0]`
+                    let (sum_axis, cmp_axis, is_max) = match ord {
+                        NormOrd::One => (ax_0, ax_1, true),
+                        NormOrd::NegOne => (ax_0, ax_1, false),
+                        NormOrd::Inf => (ax_1, ax_0, true),
+                        NormOrd::NegInf => (ax_1, ax_0, false),
+                        _ => unreachable!(),
+                    };
+                    let (storage, out_layout) = device.norm_matrix_cmp_axes(raw, layout, sum_axis, cmp_axis, is_max)?;
+                    let out_layout =
+                        reduce_layout_keepdims(out_layout, &AxesIndex::Vec(axes.to_vec()), ndim, keepdims)?;
+                    Tensor::new_f(storage, out_layout)
+                },
+            }
+        },
+        _ => rstsr_raise!(InvalidValue, "Improper number of dimensions to norm.")?,
+    }
+}
+
+fn norm_dispatch_f<T, B, D>(
+    tensor: impl TensorViewAPI<Type = T, Backend = B, Dim = D>,
+    ord: impl TryInto<NormOrd, Error: Into<Error>>,
+    axes: AxesIndex<isize>,
+    keepdims: bool,
+) -> Result<Tensor<B::TOut, B, IxD>>
+where
+    D: DimAPI,
+    B: OpNormAPI<T, IxD> + DeviceCreationAnyAPI<B::TOut>,
+{
+    let ord = ord.try_into().map_err(Into::into)?;
+    let tensor = tensor.view();
+    let layout: Layout<IxD> = tensor.layout().to_dim()?;
+    let ndim = layout.ndim();
+
+    match axes {
+        AxesIndex::None => {
+            let axes_all: Vec<isize> = (0..ndim as isize).collect_vec();
+            norm_dispatch_axes_f(tensor.device(), tensor.raw(), &layout, &axes_all, &ord, keepdims)
+        },
+        axes => {
+            let axes_norm = normalize_axes_index(axes, ndim, false, false)?;
+            norm_dispatch_axes_f(tensor.device(), tensor.raw(), &layout, &axes_norm, &ord, keepdims)
+        },
+    }
+}
