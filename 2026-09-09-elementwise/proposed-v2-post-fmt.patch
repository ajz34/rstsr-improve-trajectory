+            // established raw-pointer pattern (shared captures stay Sync via
+            // TA/TB/TC: Send + Sync)
+            let c_ptr = c.as_ptr() as *mut MaybeUninit<TC>;
+            let a_ptr = a.as_ptr();
+            let b_ptr = b.as_ptr();
