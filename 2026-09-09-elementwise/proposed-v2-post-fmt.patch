+    let g = blocked_2d_geom(lc, la, lb);
+    let task = || {
+        (0..g.n_tiles_slow).into_par_iter().for_each(|t_slow| {
+            let slow_begin = t_slow * TILE;
+            let slow_end = (slow_begin + TILE).min(g.dim_slow);
