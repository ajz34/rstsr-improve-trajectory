+    a: &[TA],
+    la: &Layout<D>,
+    b: &[TB],
+    lb: &Layout<D>,
+    f: &F,
+    pool: Option<&ThreadPool>,
+) -> Result<()>
+where
+    D: DimAPI,
+    TA: Send + Sync,
+    TB: Send + Sync,
+    TC: Send + Sync,
+    F: Fn(&mut MaybeUninit<TC>, &TA, &TB) + ?Sized + Send + Sync,
