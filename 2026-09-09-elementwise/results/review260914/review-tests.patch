+                let mut buf_c: Vec<MaybeUninit<f64>> = (0..len_c).map(|_| MaybeUninit::new(1e300)).collect();
+                let lc = layout2([m, n], sc, oc);
+                let la = layout2([m, n], sa, oa);
+                let lb = layout2([m, n], sb, ob);
