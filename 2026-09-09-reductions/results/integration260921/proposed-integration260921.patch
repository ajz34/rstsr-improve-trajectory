+/// Original iterator-walk band accumulation (the pre-rewrite code path of
+/// [`reduce_axes_cpu_serial`]'s `size_mc > 1` branch), kept as the fallback
+/// for summed spaces outside the offsets guards. Out-of-line for code-layout
+/// hygiene, mirroring [`reduce_axes_band_walk_cpu_serial`].
+#[inline(never)]
+fn reduce_axes_band_walk_iter_cpu_serial<TI, TS, F>(
+    a: &[TI],
+    vacc: &mut [TS],
+    it_scd: &IterLayoutColMajor<Vec<usize>>,
+    idx_md: usize,
+    offset: usize,
+    f: &F,
+) where
+    TI: Clone,
+    TS: Clone,
+    F: Fn(TS, TI) -> TS,
+{
+    const CHUNK: usize = 48;
+    vacc.chunks_mut(CHUNK).enumerate().for_each(|(i_chunk, vacc_chunk)| {
+        let start = i_chunk * CHUNK;
+        let nchunk = vacc_chunk.len();
+        it_scd.clone().for_each(|i_scd| {
+            let idx_in = idx_md + i_scd - offset; // double-counted offset
+            let slc = &a[idx_in + start..idx_in + start + nchunk];
+            vacc_chunk.iter_mut().zip(slc).for_each(|(acc, x)| {
+                *acc = f(acc.clone(), x.clone());
+            });
+        });
+    });
+}
