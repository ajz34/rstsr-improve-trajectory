+/// the accumulators; equal values keep the earlier (smaller) index.
+pub fn arg_contig_seeded_cpu_serial<T: Clone + PartialOrd>(xs: &[T], cmp: ArgCmp, seed: &T) -> (T, usize) {
+    const NO_POS: usize = usize::MAX;
