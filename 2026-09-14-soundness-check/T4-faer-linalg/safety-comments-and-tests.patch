+    #[test]
+    fn test_gemm_alpha_beta_gemm_from() {
+        // GEMM-style entry: c = beta * c + alpha * (a @ b), including on
+        // strided (sliced) outputs. beta != 0 exercises the scale-then-add
+        // path of gemm_faer.
+        let dev_f = device_faer_row_major();
+        let dev_s = device_serial_row_major();
+
+        let a = arange_shape(&dev_f, [3, 4]);
+        let b = arange_shape(&dev_f, [4, 5]);
+        let a_s = arange_shape_serial(&dev_s, [3, 4]);
+        let b_s = arange_shape_serial(&dev_s, [4, 5]);
+
+        // contiguous output, nonzero initial contents and beta
+        let mut c = linspace((1.0, 30.0, 15, &dev_f)).into_shape([3, 5]);
+        let mut c_s = linspace((1.0, 30.0, 15, &dev_s)).into_shape([3, 5]);
+        rt::matmul_from(c.view_mut(), &a, &b, 2.0, 0.5);
+        rt::matmul_from(c_s.view_mut(), &a_s, &b_s, 2.0, 0.5);
+        assert!(allclose_f64(&c, &c_s), "matmul_from contiguous mismatch");
+
+        // strided output: columns 2..7 of a [3, 10] tensor
+        let mut c2 = arange_shape(&dev_f, [3, 10]);
+        let mut c2_s = arange_shape_serial(&dev_s, [3, 10]);
+        {
+            let mut c2_v = c2.slice_mut(s![.., 2..7]);
+            let mut c2_v_s = c2_s.slice_mut(s![.., 2..7]);
+            rt::matmul_from(c2_v.view_mut(), &a, &b, 1.5, 2.0);
+            rt::matmul_from(c2_v_s.view_mut(), &a_s, &b_s, 1.5, 2.0);
+        }
+        assert!(allclose_f64(&c2, &c2_s), "matmul_from strided-output mismatch");
+    }
+
+    #[test]
+    fn test_gemm_col_major_default_order() {
+        // col-major device default order computes C^T = B^T A^T internally;
+        // results must match the serial row-major reference values. Tensors
+        // are built on the serial (row-major) device and transferred with
+        // `to_device`, so both devices see identical values AND layouts
+        // (creating tensors directly under a col-major default order yields
+        // f-order interpretations with different values).
+        let dev_f = device_faer_col_major();
+        let dev_s = device_serial_row_major();
+        let a_s = arange_shape_serial(&dev_s, [3, 4]);
+        let b_s = arange_shape_serial(&dev_s, [4, 5]);
+        let a = a_s.to_device(&dev_f);
+        let b = b_s.to_device(&dev_f);
+        let c = &a % &b;
+        let c_ref = &a_s % &b_s;
+        assert!(allclose_f64(&c, &c_ref), "col-major order gemm mismatch:\nfaer: {c}\nserial: {c_ref}");
+
+        // col-major with transposed operands (2-D rules agree under both
+        // conventions: contract the last axis of the first operand with the
+        // first axis of the second)
+        let c2 = &b.t() % &a.t();
+        let c2_ref = &b_s.t() % &a_s.t();
+        assert!(allclose_f64(&c2, &c2_ref), "col-major order transposed gemm mismatch");
+
+        // batched (rule 7 col-major): batch axes are *trailing* under the
+        // col-major convention. X [4, 3, 2] % Y [3, 5, 2] contracts X's
+        // axis-1 with Y's axis-0. Equivalent row-major computation:
+        // R = Y.t() % X.t() with C = R.t() (as values).
+        let x_s = arange((0.0, 4.0 * 3.0 * 2.0, 1.0, &dev_s)).into_shape([4, 3, 2]);
+        let y_s = arange((0.0, 3.0 * 5.0 * 2.0, 1.0, &dev_s)).into_shape([3, 5, 2]);
+        let x = x_s.to_device(&dev_f);
+        let y = y_s.to_device(&dev_f);
+        let c3 = &x % &y;
+        let c3_ref_prod = &y_s.t() % &x_s.t();
+        let c3_ref = c3_ref_prod.t();
+        assert_eq!(c3.shape(), &[4, 5, 2]);
+        assert!(allclose_f64(&c3, &c3_ref), "col-major order batched mismatch");
+    }
