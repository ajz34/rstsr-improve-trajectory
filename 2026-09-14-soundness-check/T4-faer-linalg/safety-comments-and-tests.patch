+
+    /* #region edge-shape correctness tests (T4 faer linalg audit, 2026-09) */
+
+    use crate::prelude::rt;
+
+    fn device_faer_row_major() -> DeviceFaer {
+        let mut device = DeviceFaer::default();
+        device.set_default_order(RowMajor);
+        device
+    }
+
+    fn device_faer_col_major() -> DeviceFaer {
+        let mut device = DeviceFaer::default();
+        device.set_default_order(ColMajor);
+        device
+    }
+
+    fn device_serial_row_major() -> DeviceCpuSerial {
+        let mut device = DeviceCpuSerial::default();
+        device.set_default_order(RowMajor);
+        device
+    }
+
+    /// `arange`-based deterministic 2-D tensor of the requested shape.
+    fn arange_shape(device: &DeviceFaer, shape: [usize; 2]) -> Tensor<f64, DeviceFaer, IxD> {
+        let (m, k) = (shape[0], shape[1]);
+        arange((0.0, (m * k) as f64, 1.0, device)).into_shape([m, k])
+    }
+
+    fn arange_shape_serial(device: &DeviceCpuSerial, shape: [usize; 2]) -> Tensor<f64, DeviceCpuSerial, IxD> {
+        let (m, k) = (shape[0], shape[1]);
+        arange((0.0, (m * k) as f64, 1.0, device)).into_shape([m, k])
+    }
+
+    #[test]
+    fn test_gemm_edge_shapes_row_major() {
+        // faer must agree with the naive serial implementation on degenerate
+        // shapes: zero-sized axes, 1x1 gemms, gemv-like extremes, and odd
+        // non-multiples of internal block sizes.
+        let shapes = [
+            [0usize, 0],
+            [1, 1],
+            [3, 0], // K = 0 (A [m, 0] @ B [0, n])
+            [0, 4], // M = 0
+            [1, 9],
+            [9, 1],
+            [2, 3],
+            [7, 13],
+            [17, 19],
+            [31, 2],
+        ];
+        for shape_a in shapes {
+            for shape_b in [[0usize, 2], [1, 1], [2, 5], [4, 3], [8, 8]] {
+                let dev_f = device_faer_row_major();
+                let dev_s = device_serial_row_major();
+                let (m, k) = (shape_a[0], shape_a[1]);
+                if shape_b[0] != k {
+                    continue; // only compatible (m, k) @ (k, n) pairs
+                }
+                let n = shape_b[1];
+                let a = arange_shape(&dev_f, shape_a);
+                let b = arange_shape(&dev_f, shape_b);
+                let a_s = arange_shape_serial(&dev_s, shape_a);
+                let b_s = arange_shape_serial(&dev_s, shape_b);
+                let c = &a % &b;
+                let c_ref = &a_s % &b_s;
+                assert_eq!(c.shape(), &[m, n]);
+                assert_eq!(c_ref.shape(), &[m, n]);
+                assert!(
+                    allclose_f64(&c, &c_ref),
+                    "mismatch for shape ({m},{k}) @ ({k},{n}):\nfaer: {c}\nserial: {c_ref}"
+                );
+            }
+        }
+    }
+
+    #[test]
+    fn test_gemm_transposed_and_strided_operands() {
+        // transposed views, sliced views with nonzero offset, and strided
+        // slices must be passed to faer with correct strides (no silent
+        // transposition / garbage reads).
+        let dev_f = device_faer_row_major();
+        let dev_s = device_serial_row_major();
+
+        // A [3, 5] and B = A^T: syrk-like input through transposed view
+        let a = arange_shape(&dev_f, [3, 5]);
+        let a_s = arange_shape_serial(&dev_s, [3, 5]);
+        let c1 = &a % &a.t();
+        let c1_ref = &a_s % &a_s.t();
+        assert!(allclose_f64(&c1, &c1_ref), "A @ A^T mismatch");
+
+        // reversed: A^T @ A (also hits the syrk fast path in faer device)
+        let c2 = &a.t() % &a;
+        let c2_ref = &a_s.t() % &a_s;
+        assert!(allclose_f64(&c2, &c2_ref), "A^T @ A mismatch");
+
+        // offset view: slice rows 1.. of a [5, 6] tensor
+        let big = arange_shape(&dev_f, [5, 6]);
+        let big_s = arange_shape_serial(&dev_s, [5, 6]);
+        let a_off = big.slice(s![1..4, 1..5]); // [3, 4], nonzero offset
+        let a_off_s = big_s.slice(s![1..4, 1..5]);
+        let b_off = big.slice(s![1..5, 0..3]); // [4, 3]
+        let b_off_s = big_s.slice(s![1..5, 0..3]);
+        let c3 = &a_off % &b_off;
+        let c3_ref = &a_off_s % &b_off_s;
+        assert!(allclose_f64(&c3, &c3_ref), "offset-view gemm mismatch");
+
+        // stride-2 slice
+        let a_str = big.slice(s![0..5, slice!(0, 6, 2)]); // [5, 3], col stride 2
+        let a_str_s = big_s.slice(s![0..5, slice!(0, 6, 2)]);
+        let b_str = big.slice(s![0..3, 0..4]);
+        let b_str_s = big_s.slice(s![0..3, 0..4]);
+        let c4 = &a_str % &b_str;
+        let c4_ref = &a_str_s % &b_str_s;
+        assert!(allclose_f64(&c4, &c4_ref), "stride-2 gemm mismatch");
+
+        // broadcast stride-0 column: A [3, 1] broadcast to [3, 4]
+        let a_col = arange_shape(&dev_f, [3, 1]);
+        let a_col_s = arange_shape_serial(&dev_s, [3, 1]);
+        let a_b = a_col.to_broadcast(vec![3, 4]);
+        let a_b_s = a_col_s.to_broadcast(vec![3, 4]);
+        let b42 = big.slice(s![0..4, 0..2]); // [4, 2]
+        let b42_s = big_s.slice(s![0..4, 0..2]);
+        let c5 = &a_b % &b42;
+        let c5_ref = &a_b_s % &b42_s;
+        assert!(allclose_f64(&c5, &c5_ref), "stride-0 broadcast A gemm mismatch");
+    }
+
+    #[test]
+    fn test_gemm_batch_parallel_and_serial_paths() {
+        // exercise both the parallel-outer (`n_task > 4 * nthreads`) and the
+        // sequential-outer broadcast paths with odd rest-dim shapes.
+        let dev_f = device_faer_row_major();
+        let dev_s = device_serial_row_major();
+
+        // parallel-outer path: 3*37 = 111 tasks > 4 * nthreads (16 cores);
+        // A's batch dims broadcast against B's ([1, 37] -> [3, 37]).
+        let a = arange((0.0, 1.0 * 37.0 * 5.0 * 7.0, 1.0, &dev_f)).into_shape([1, 37, 5, 7]);
+        let b = arange((0.0, 3.0 * 37.0 * 7.0 * 4.0, 1.0, &dev_f)).into_shape([3, 37, 7, 4]);
+        let c = &a % &b;
+        let a_s = arange((0.0, 1.0 * 37.0 * 5.0 * 7.0, 1.0, &dev_s)).into_shape([1, 37, 5, 7]);
+        let b_s = arange((0.0, 3.0 * 37.0 * 7.0 * 4.0, 1.0, &dev_s)).into_shape([3, 37, 7, 4]);
+        let c_ref = &a_s % &b_s;
+        assert_eq!(c.shape(), &[3, 37, 5, 4]);
+        assert!(allclose_f64(&c, &c_ref), "rule-7 parallel-outer mismatch");
+
+        // sequential-outer path: n_task <= 4 * nthreads
+        let a2 = arange((0.0, 2.0 * 3.0 * 3.0 * 4.0, 1.0, &dev_f)).into_shape([2, 3, 3, 4]);
+        let b2 = arange((0.0, 2.0 * 3.0 * 4.0 * 5.0, 1.0, &dev_f)).into_shape([2, 3, 4, 5]);
+        let c2 = &a2 % &b2;
+        let a2_s = arange((0.0, 2.0 * 3.0 * 3.0 * 4.0, 1.0, &dev_s)).into_shape([2, 3, 3, 4]);
+        let b2_s = arange((0.0, 2.0 * 3.0 * 4.0 * 5.0, 1.0, &dev_s)).into_shape([2, 3, 4, 5]);
+        let c2_ref = &a2_s % &b2_s;
+        assert!(allclose_f64(&c2, &c2_ref), "rule-7 sequential-outer mismatch");
+
+        // single-threaded device must agree too
+        let mut dev_f1 = DeviceFaer::new(1);
+        dev_f1.set_default_order(RowMajor);
+        let c3 = {
+            let a3 = arange((0.0, 1.0 * 37.0 * 5.0 * 7.0, 1.0, &dev_f1)).into_shape([1, 37, 5, 7]);
+            let b3 = arange((0.0, 3.0 * 37.0 * 7.0 * 4.0, 1.0, &dev_f1)).into_shape([3, 37, 7, 4]);
+            &a3 % &b3
+        };
+        assert!(allclose_f64(&c3, &c_ref), "rule-7 single-thread mismatch");
+    }
