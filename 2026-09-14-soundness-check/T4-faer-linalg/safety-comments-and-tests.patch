+    #[test]
+    fn test_numpy_reference_eigh_eigvalsh() {
+        let device = DeviceFaer::default();
+        let s = as_mat(&S, [4, 4], &device);
+        let w_ref = rt::asarray((EIGH_W.to_vec(), &device)).into_dim::<Ix1>();
+
+        let (w, v) = rt::linalg::eigh(&s).into();
+        assert!(max_abs_diff_1d(&w, &w_ref) < 1e-10);
+        // property: S @ v == v @ diag(w)
+        let sv = &s % &v;
+        let vd = {
+            let mut r = zeros_2d([4, 4], &device);
+            for j in 0..4 {
+                for i in 0..4 {
+                    r[[i, j]] = v[[i, j]] * w[[j]];
+                }
+            }
+            r
+        };
+        assert!(max_abs_diff(&sv, &vd) < 1e-10);
+
+        let w2 = rt::linalg::eigvalsh(&s);
+        assert!(max_abs_diff_1d(&w2, &w_ref) < 1e-10);
+
+        // uplo flags agree on a symmetric matrix
+        let w_lower = rt::linalg::eigvalsh((&s, Lower));
+        let w_upper = rt::linalg::eigvalsh((&s, Upper));
+        assert!(max_abs_diff_1d(&w_lower, &w_ref) < 1e-10);
+        assert!(max_abs_diff_1d(&w_upper, &w_ref) < 1e-10);
+    }
+
+    #[test]
+    fn test_numpy_reference_cholesky() {
+        let device = DeviceFaer::default();
+        let c = as_mat(&C_MAT, [4, 4], &device);
+        let l_ref = as_mat(&CHOL_L, [4, 4], &device);
+
+        let l = rt::linalg::cholesky((&c, Lower));
+        assert!(max_abs_diff(&l, &l_ref) < 1e-10);
+
+        // upper == lower^T
+        let u = rt::linalg::cholesky((&c, Upper));
+        assert!(max_abs_diff(&u, &l.t().to_owned()) < 1e-10);
+
+        // property: L @ L^T == C
+        let ll = &l % &l.t().to_owned();
+        assert!(max_abs_diff(&ll, &c) < 1e-10);
+
+        // default (row-major device order -> lower)
+        let l_default = rt::linalg::cholesky(&c);
+        assert!(max_abs_diff(&l_default, &l_ref) < 1e-10);
+
+        // error contract: non-SPD matrix must raise, not panic
+        let bad = as_mat(&[1.0, 2.0, 2.0, 1.0], [2, 2], &device);
+        assert!(rt::linalg::cholesky_f((&bad, Lower)).is_err());
+    }
