+    #[test]
+    fn test_solve_singular_current_contract() {
+        // DOCUMENTED CONTRACT (faer SVD-based solve): exactly singular
+        // systems do NOT raise (numpy would raise LinAlgError); they return
+        // non-finite values. This test pins the current behavior so any
+        // future contract change (raising an error) is deliberate.
+        let device = DeviceFaer::default();
+        let s = as_mat(&[1.0, 2.0, 2.0, 4.0], [2, 2], &device);
+        let b = as_mat(&[1.0, 1.0], [2, 1], &device);
+        let x = rt::linalg::solve_general((&s, &b));
+        assert_eq!(x.shape(), &[2, 1]);
+        let non_finite = x.raw().iter().any(|v| !v.is_finite());
+        assert!(non_finite, "singular solve currently returns non-finite values");
+    }
