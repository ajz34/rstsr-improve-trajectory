+    #[test]
+    fn test_numpy_reference_svd() {
+        let device = DeviceFaer::default();
+        let m = as_mat(&M, [4, 6], &device);
+        let s_ref = rt::asarray((SVD_S.to_vec(), &device)).into_dim::<Ix1>();
+
+        // full matrices
+        let (u, s, vt) = rt::linalg::svd((&m, true)).into();
+        assert!(max_abs_diff_1d(&s, &s_ref) < 1e-10);
+        assert_eq!(u.shape(), &[4, 4]);
+        assert_eq!(vt.shape(), &[6, 6]);
+
+        // thin matrices
+        let (u, s, vt) = rt::linalg::svd((&m, false)).into();
+        assert!(max_abs_diff_1d(&s, &s_ref) < 1e-10);
+        assert_eq!(u.shape(), &[4, 4]);
+        assert_eq!(vt.shape(), &[4, 6]);
+
+        // property: m == u @ diag(s) @ vt
+        let mut us = zeros_2d([4, 4], &device);
+        for j in 0..4 {
+            for i in 0..4 {
+                us[[i, j]] = u[[i, j]] * s[[j]];
+            }
+        }
+        let recon = &us % &vt;
+        assert!(max_abs_diff(&recon, &m) < 1e-10);
+
+        // svdvals
+        let sv = rt::linalg::svdvals(&m);
+        assert!(max_abs_diff_1d(&sv, &s_ref) < 1e-10);
+    }
+
+    #[test]
+    fn test_numpy_reference_pinv() {
+        let device = DeviceFaer::default();
+        let r2 = as_mat(&RANK2, [4, 4], &device);
+        let pinv_ref = as_mat(&PINV_R2, [4, 4], &device);
+
+        let (pinv, rank) = rt::linalg::pinv(&r2).into();
+        assert_eq!(rank, 2);
+        assert!(max_abs_diff(&pinv, &pinv_ref) < 1e-8);
+
+        // property: r2 @ pinv @ r2 == r2 (Moore-Penrose)
+        let tmp = &r2 % &pinv;
+        let recon = &tmp % &r2;
+        assert!(max_abs_diff(&recon, &r2) < 1e-8);
+    }
