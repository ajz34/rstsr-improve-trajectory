+    #[test]
+    fn test_numpy_reference_solve_triangular() {
+        let device = DeviceFaer::default();
+        let l4 = as_mat(&L4, [4, 4], &device);
+        // first 4 rows of B, [4, 3]
+        let b4 = as_mat(&B[..12].to_vec().as_slice(), [4, 3], &device);
+        let x_ref = as_mat(&TRI_X, [4, 3], &device);
