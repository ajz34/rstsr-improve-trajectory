+        let dev_s = device_serial_row_major();
+        for n in [0usize, 1, 2, 3, 17, 64, 65, 129] {
+            let a = arange((0.0, n as f64, 1.0, &dev_f));
+            let b = arange((0.0, n as f64, 1.0, &dev_f)) * 2.0 - 1.0;
+            let a_s = arange((0.0, n as f64, 1.0, &dev_s));
+            let b_s = arange((0.0, n as f64, 1.0, &dev_s)) * 2.0 - 1.0;
+            let c = &a % &b;
+            let c_ref = &a_s % &b_s;
+            assert!(allclose_f64(&c, &c_ref), "inner dot mismatch for n = {n}");
+        }
+
+        // strided views
+        let big = arange((0.0, 40.0, 1.0, &dev_f));
+        let big_s = arange((0.0, 40.0, 1.0, &dev_s));
+        let a = big.slice(s![slice!(1, 38, 2)]); // 19 elements, stride 2, offset 1
+        let b = big.slice(s![slice!(0, 38, 2)]);
