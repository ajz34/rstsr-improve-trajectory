+// Edge-case and device-contract tests for the DeviceFaer linalg drivers.
+//
+// These tests complement `test_faer_func` (which checks 1024x1024
+// fingerprints against generated npy resources): here we check
+// - degenerate shapes (0x0, 1x1) and their error contracts,
+// - numpy-derived constants on small fixed matrices (no npy resources needed),
+// - non-contiguous (sliced / strided / f-order) inputs,
+// - col-major device default order.
+mod edge_c64;
+mod edge_f64;
