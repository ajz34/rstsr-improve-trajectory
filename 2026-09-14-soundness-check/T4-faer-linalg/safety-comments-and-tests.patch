+    #[test]
+    fn test_numpy_reference_generalized_eigh() {
+        let device = DeviceFaer::default();
+        let s = as_mat(&S, [4, 4], &device);
+        let c = as_mat(&C_MAT, [4, 4], &device);
+        let w_ref = rt::asarray((GEN_W.to_vec(), &device)).into_dim::<Ix1>();
+
+        // itype 1: S x = lambda C x
+        let (w, v) = rt::linalg::eigh((&s, &c, Lower, 1)).into();
+        assert!(max_abs_diff_1d(&w, &w_ref) < 1e-9);
+
+        // property: S @ v == C @ v @ diag(w)
+        let sv = &s % &v;
+        let cvw = {
+            let cv = &c % &v;
+            let mut r = zeros_2d([4, 4], &device);
+            for j in 0..4 {
+                for i in 0..4 {
+                    r[[i, j]] = cv[[i, j]] * w[[j]];
+                }
+            }
+            r
+        };
+        assert!(max_abs_diff(&sv, &cvw) < 1e-9);
+    }
