+    #[test]
+    fn test_numpy_reference_solve_inv_det() {
+        let device = DeviceFaer::default();
+        let a = as_mat(&A, [5, 5], &device);
+        let b = as_mat(&B, [5, 3], &device);
+        let b_vec = rt::asarray((B_VEC.to_vec(), &device)).into_dim::<Ix1>();
+
+        let x = rt::linalg::solve_general((&a, &b));
+        let x_ref = as_mat(&X, [5, 3], &device);
+        assert!(max_abs_diff(&x.into_dim::<Ix2>(), &x_ref) < 1e-10);
+
+        let x_vec = rt::linalg::solve_general((&a, &b_vec));
+        let x_vec_ref = rt::asarray((X_VEC.to_vec(), &device)).into_dim::<Ix1>();
+        assert!(max_abs_diff_1d(&x_vec.into_dim::<Ix1>(), &x_vec_ref) < 1e-10);
+
+        let inv_a = rt::linalg::inv(&a);
+        let inv_ref = as_mat(&INV_A, [5, 5], &device);
+        assert!(max_abs_diff(&inv_a, &inv_ref) < 1e-10);
+
+        let det = rt::linalg::det(&a);
+        assert!((det - DET_A).abs() < 1e-8);
+
+        // property: A @ inv(A) == I
+        let eye = &a % &inv_a;
+        let mut eye_ref = zeros_2d([5, 5], &device);
+        for i in 0..5 {
+            eye_ref[[i, i]] = 1.0;
+        }
+        assert!(max_abs_diff(&eye, &eye_ref) < 1e-10);
+    }
