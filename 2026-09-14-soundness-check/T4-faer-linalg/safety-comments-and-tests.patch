+    0.09198705245078603, -0.09241643546043067, -0.5261593341260408, 1.1163958250759682, -0.09241643546043053,
+    0.558197912537984,
+];
+const L4: [f64; 16] = [
+    2.1864150912790823, 0.0, 0.0, 0.0, -0.9851976076801512, 3.680855566501356, 0.0, 0.0, 0.2452058672765945,
+    -0.5574464095855782, 3.1680304281087817, 0.0, -1.256953283529997, 1.0050082841418608, -0.3364772692317709,
+    4.750016645540782,
+];
+const TRI_X: [f64; 12] = [
+    -0.7113720883891238, -0.22905275147661486, 0.026008160367689916, 0.14488555145774387, -0.4676253240202389,
+    0.13177502332746693, 0.17016807220915434, -0.20238001354845586, 0.14989512595661844, -0.08419121809280061,
+    0.02706705876659449, -0.1537373595448312,
+];
+const GEN_W: [f64; 4] = [0.41282354881061784, 0.4877004609416579, 0.5514781029575679, 0.7028590184115933];
+
+fn max_abs_diff(a: &Tensor<f64, DeviceFaer, Ix2>, b: &Tensor<f64, DeviceFaer, Ix2>) -> f64 {
+    assert_eq!(a.shape(), b.shape());
+    let [m, n] = *a.shape();
+    let mut r: f64 = 0.0;
+    for i in 0..m {
+        for j in 0..n {
+            r = r.max((a[[i, j]] - b[[i, j]]).abs());
+        }
+    }
+    r
+}
+
+fn max_abs_diff_1d(a: &Tensor<f64, DeviceFaer, Ix1>, b: &Tensor<f64, DeviceFaer, Ix1>) -> f64 {
+    assert_eq!(a.shape(), b.shape());
+    let n = a.shape()[0];
+    let mut r: f64 = 0.0;
+    for i in 0..n {
+        r = r.max((a[[i]] - b[[i]]).abs());
+    }
+    r
+}
+
+fn zeros_2d(shape: [usize; 2], device: &DeviceFaer) -> Tensor<f64, DeviceFaer, Ix2> {
+    rt::zeros((shape.c(), device)).into_dim::<Ix2>()
+}
+
+fn as_mat(data: &[f64], shape: [usize; 2], device: &DeviceFaer) -> Tensor<f64, DeviceFaer, Ix2> {
+    rt::asarray((data.to_vec(), shape.c(), device)).into_dim::<Ix2>()
+}
