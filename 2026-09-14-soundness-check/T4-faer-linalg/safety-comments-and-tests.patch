+    #[test]
+    fn test_gemm_dtype_coverage() {
+        // f32 / c32 / c64 go through faer; i32 falls back to the naive
+        // kernel. All must match the serial device.
+        #[allow(non_camel_case_types)]
+        type c64 = num::Complex<f64>;
+        #[allow(non_camel_case_types)]
+        type c32 = num::Complex<f32>;
+        let dev_f = device_faer_row_major();
+        let dev_s = device_serial_row_major();
+
+        // f32
+        let a = arange((0.0f32, 12.0f32, 1.0f32, &dev_f)).into_shape([3, 4]);
