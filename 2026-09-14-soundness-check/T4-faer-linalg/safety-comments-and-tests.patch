+        // alpha/beta path on a 0-dim output
+        let mut c2: Tensor<f64, DeviceFaer, Ix0> = full(([], 7.0, &dev_f)).into_dim::<Ix0>();
+        let mut c2_s: Tensor<f64, DeviceCpuSerial, Ix0> = full(([], 7.0, &dev_s)).into_dim::<Ix0>();
