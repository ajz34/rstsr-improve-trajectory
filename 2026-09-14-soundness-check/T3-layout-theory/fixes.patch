+#[cfg(test)]
+mod test {
+    use super::*;
+
+    #[test]
+    fn test_reshape_substitute_negatives() {
+        // general case
+        assert_eq!(reshape_substitute_negatives(&[2, -1], 6).unwrap(), vec![2, 3]);
+        assert_eq!(reshape_substitute_negatives(&[-1], 6).unwrap(), vec![6]);
+        assert_eq!(reshape_substitute_negatives(&[-1, 3], 6).unwrap(), vec![2, 3]);
+        assert_eq!(reshape_substitute_negatives(&[2, -1, 3], 12).unwrap(), vec![2, 2, 3]);
+        // no negative in shape
+        assert_eq!(reshape_substitute_negatives(&[2, 3], 6).unwrap(), vec![2, 3]);
+        // zero size tensor; -1 resolves to 0
+        assert_eq!(reshape_substitute_negatives(&[-1], 0).unwrap(), vec![0]);
+        assert_eq!(reshape_substitute_negatives(&[3, -1], 0).unwrap(), vec![3, 0]);
+        // cannot be divided
+        assert!(reshape_substitute_negatives(&[3, -1], 7).is_err());
+        // two -1 is not allowed
+        assert!(reshape_substitute_negatives(&[-1, -1], 6).is_err());
+        // negative other than -1 is not allowed
+        assert!(reshape_substitute_negatives(&[-2, 3], 6).is_err());
+        // zero in the known dims: cannot infer -1 (numpy raises ValueError as well);
+        // this should be an error, not an arithmetic panic
+        assert!(reshape_substitute_negatives(&[0, -1], 5).is_err());
+        assert!(reshape_substitute_negatives(&[0, -1], 0).is_err());
+        // overflow of the known dims should be an error, not a panic
+        assert!(reshape_substitute_negatives(&[isize::MAX, isize::MAX, -1], 6).is_err());
+    }
+}
