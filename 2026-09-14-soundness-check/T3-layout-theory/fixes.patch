+        assert_eq!(translated[0].ndim(), 0);
+        assert_eq!(translated[0].offset(), 42);
+        let translated = translate_to_col_major(&[&layout], Order::B).unwrap();
+        assert_eq!(translated[0].ndim(), 0);
