+    fn test_translate_to_col_major_zero_dim() {
+        // 0-dim layout: every order should work without panic; buffer-order is
+        // valid because a 0-dim layout contains exactly one element
+        let layout = Layout::new([], [], 42).unwrap();
+        for order in [Order::C, Order::F, Order::A, Order::K, Order::G, Order::B] {
