@@ -0,0 +1,166 @@
+//! Reshape / transpose / moveaxis / flip / layout conversions under col order.
+
+use super::*;
+
+#[test]
+fn test_reshape_reading_invariance() {
+    let device = col_dev();
+    let a = rt::arange((24, &device)).into_shape([2, 3, 4]);
+    // col-major reading of arange-packed [2, 3, 4] is 0..24 in buffer order
+    assert_eq!(a.reshape([24]).to_vec(), (0..24).collect::<Vec<_>>());
+    let b = a.reshape([6, 4]);
+    assert_eq!(b.shape(), &[6, 4]);
+    // logical content is preserved: value v sits at the same reading position
+    assert_eq!(b[[0, 0]], 0);
+    assert_eq!(b[[5, 3]], 23);
+    // reading position p lands at (p % 6, p / 6) in the [6, 4] output
+    assert_eq!(b[[1, 1]], 7);
+}
+
+#[test]
+fn test_reshape_copy_when_crossing_contiguity() {
+    let device = col_dev();
+    // documentated example: leading axes merge for free, merging across the
+    // f-contiguity boundary copies
+    let a = rt::arange((288, &device)).into_shape([4, 8, 9]).into_slice((.., 0..6, ..));
+    assert_eq!(a.shape(), &[4, 6, 9]);
+    assert_eq!(a.stride(), &[1, 4, 32]);
+    let lead = a.reshape([24, 9]);
+    assert!(!lead.is_owned());
+    let cross = a.reshape([4, 54]);
+    assert!(cross.is_owned());
+}
+
+#[test]
+fn test_transpose_round_trip() {
+    let device = col_dev();
+    let a = rt::arange((12, &device)).into_shape([3, 4]);
+    let at = a.t();
+    assert_eq!(at.shape(), &[4, 3]);
+    assert_eq!(at.stride(), &[3, 1]);
+    // double transpose restores everything
+    let att = at.t();
+    assert_eq!(att.shape(), a.shape());
+    assert_eq!(att.stride(), a.stride());
+    for i in 0..3 {
+        for j in 0..4 {
+            assert_eq!(att[[i, j]], a[[i, j]]);
+        }
+    }
+    // transposed logical content: at[i, j] == a[j, i]
+    assert_eq!(at[[0, 1]], a[[1, 0]]);
+    assert_eq!(at[[3, 2]], a[[2, 3]]);
+}
+
+#[test]
+fn test_moveaxis_round_trip() {
+    let device = col_dev();
+    let a = rt::arange((24, &device)).into_shape([2, 3, 4]);
+    let m = a.moveaxis(2, 0); // -> [4, 2, 3]
+    assert_eq!(m.shape(), &[4, 2, 3]);
+    assert_eq!(m.stride(), &[6, 1, 2]);
+    assert_eq!(m[[1, 0, 0]], 6); // old (0, 0, 1)
+    let back = m.moveaxis(0, 2); // -> [2, 3, 4]
+    assert_eq!(back.shape(), a.shape());
+    for i in 0..2 {
+        for j in 0..3 {
+            for k in 0..4 {
+                assert_eq!(back[[i, j, k]], a[[i, j, k]]);
+            }
+        }
+    }
+}
+
+#[test]
+fn test_flip_logical() {
+    let device = col_dev();
+    let a = rt::arange((6, &device)).into_shape([2, 3]);
+    // logical [[0, 2, 4], [1, 3, 5]]
+    let f0 = rt::flip(&a, 0);
+    assert_eq!((f0[[0, 0]], f0[[0, 1]], f0[[1, 0]]), (1, 3, 0));
+    let f1 = rt::flip(&a, 1);
+    assert_eq!((f1[[0, 0]], f1[[0, 2]], f1[[1, 2]]), (4, 0, 1));
+}
+
+#[test]
+fn test_squeeze_expand_dims() {
+    let device = col_dev();
+    let a = rt::arange((6, &device)).into_shape([2, 1, 3]);
+    let s = rt::squeeze(&a, 1);
+    assert_eq!(s.shape(), &[2, 3]);
+    assert_eq!(s.stride(), &[1, 2]);
+    let e = rt::expand_dims(&s, 0);
+    assert_eq!(e.shape(), &[1, 2, 3]);
+    assert_eq!(e[[0, 0, 0]], 0);
+    assert_eq!(e[[0, 1, 2]], 5);
+    let sq = s.squeeze(None);
+    assert_eq!(sq.shape(), &[2, 3]);
+}
+
+#[test]
+fn test_to_contig_col_device() {
+    let device = col_dev();
+    let a = rt::arange((6, &device)).into_shape([2, 3]);
+    let c = a.to_contig(ColMajor);
+    assert!(c.f_contig());
+    // to_contig with explicit row order
+    let r = a.to_contig(RowMajor);
+    assert!(r.c_contig());
+    assert_eq!(r.stride(), &[3, 1]);
+}
+
+#[test]
+fn test_to_layout_values_preserved() {
+    let device = col_dev();
+    let a = rt::arange((12, &device)).into_shape([3, 4]);
+    let c = a.to_layout([3, 4].c());
+    assert!(c.c_contig());
+    // logical values unchanged after reorder copy
+    for i in 0..3 {
+        for j in 0..4 {
+            assert_eq!(c[[i, j]], a[[i, j]]);
+        }
+    }
+}
+
+#[test]
+fn test_broadcast_shapes_explicit_orders() {
+    // col-major aligns from the first axis (Fortran/Julia rule)
+    assert_eq!(rt::broadcast_shapes(&[vec![1, 6, 1, 8], vec![5, 1, 7]], ColMajor), vec![5, 6, 7, 8]);
+    // row-major aligns from the last axis (NumPy rule)
+    assert_eq!(rt::broadcast_shapes(&[vec![8, 1, 6, 1], vec![7, 1, 5]], RowMajor), vec![8, 7, 6, 5]);
+}
+
+#[test]
+fn test_broadcast_to_col() {
+    let device = col_dev();
+    let v = rt::arange((3, &device)).into_shape([3, 1]);
+    let b = rt::broadcast_to(&v, vec![3, 2]);
+    assert_eq!(b.shape(), &[3, 2]);
+    assert_eq!((b[[0, 0]], b[[0, 1]], b[[2, 0]]), (0, 0, 2));
+}
+
+#[test]
+fn test_concat_axis_logical() {
+    let device = col_dev();
+    let a = rt::arange((6, &device)).into_shape([2, 3]);
+    let b = rt::arange((6, &device)).into_shape([2, 3]) + 6;
+    let c = rt::concatenate((vec![&a, &b], 0isize));
+    assert_eq!(c.shape(), &[4, 3]);
+    assert_eq!(c[[0, 0]], 0);
+    assert_eq!(c[[2, 0]], 6);
+    let d = rt::concatenate((vec![&a, &b], 1isize));
+    assert_eq!(d.shape(), &[2, 6]);
+    assert_eq!(d[[0, 3]], 6);
+    assert_eq!(d[[1, 5]], 11);
+}
+
+#[test]
+fn test_diag_col_device() {
+    let device = col_dev();
+    let a = rt::arange((9, &device)).into_shape([3, 3]);
+    let d = rt::diag((&a, 0));
+    assert_eq!(d.to_vec(), vec![0, 4, 8]);
+    let d1 = rt::diag((&a, 1));
+    assert_eq!(d1.to_vec(), vec![3, 7]);
+}
diff --git a/rstsr-core/tests/col_func/test_matmul_col.rs b/rstsr-core/tests/col_func/test_matmul_col.rs
