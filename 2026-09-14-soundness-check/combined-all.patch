+    #[test]
+    fn test_gemm_alpha_beta_gemm_from() {
+        // GEMM-style entry: c = beta * c + alpha * (a @ b), including on
+        // strided (sliced) outputs. beta != 0 exercises the scale-then-add
+        // path of gemm_faer.
+        let dev_f = device_faer_row_major();
+        let dev_s = device_serial_row_major();
+
+        let a = arange_shape(&dev_f, [3, 4]);
+        let b = arange_shape(&dev_f, [4, 5]);
+        let a_s = arange_shape_serial(&dev_s, [3, 4]);
+        let b_s = arange_shape_serial(&dev_s, [4, 5]);
+
+        // contiguous output, nonzero initial contents and beta
+        let mut c = linspace((1.0, 30.0, 15, &dev_f)).into_shape([3, 5]);
+        let mut c_s = linspace((1.0, 30.0, 15, &dev_s)).into_shape([3, 5]);
+        rt::matmul_from(c.view_mut(), &a, &b, 2.0, 0.5);
+        rt::matmul_from(c_s.view_mut(), &a_s, &b_s, 2.0, 0.5);
+        assert!(allclose_f64(&c, &c_s), "matmul_from contiguous mismatch");
+
+        // strided output: columns 2..7 of a [3, 10] tensor
+        let mut c2 = arange_shape(&dev_f, [3, 10]);
+        let mut c2_s = arange_shape_serial(&dev_s, [3, 10]);
+        {
+            let mut c2_v = c2.slice_mut(s![.., 2..7]);
+            let mut c2_v_s = c2_s.slice_mut(s![.., 2..7]);
+            rt::matmul_from(c2_v.view_mut(), &a, &b, 1.5, 2.0);
+            rt::matmul_from(c2_v_s.view_mut(), &a_s, &b_s, 1.5, 2.0);
+        }
+        assert!(allclose_f64(&c2, &c2_s), "matmul_from strided-output mismatch");
+    }
