+    #[test]
+    fn test_gemm_transposed_and_strided_operands() {
+        // transposed views, sliced views with nonzero offset, and strided
+        // slices must be passed to faer with correct strides (no silent
+        // transposition / garbage reads).
+        let dev_f = device_faer_row_major();
+        let dev_s = device_serial_row_major();
+
+        // A [3, 5] and B = A^T: syrk-like input through transposed view
+        let a = arange_shape(&dev_f, [3, 5]);
+        let a_s = arange_shape_serial(&dev_s, [3, 5]);
+        let c1 = &a % &a.t();
+        let c1_ref = &a_s % &a_s.t();
+        assert!(allclose_f64(&c1, &c1_ref), "A @ A^T mismatch");
+
+        // reversed: A^T @ A (also hits the syrk fast path in faer device)
+        let c2 = &a.t() % &a;
+        let c2_ref = &a_s.t() % &a_s;
+        assert!(allclose_f64(&c2, &c2_ref), "A^T @ A mismatch");
+
+        // offset view: slice rows 1.. of a [5, 6] tensor
+        let big = arange_shape(&dev_f, [5, 6]);
+        let big_s = arange_shape_serial(&dev_s, [5, 6]);
+        let a_off = big.slice(s![1..4, 1..5]); // [3, 4], nonzero offset
+        let a_off_s = big_s.slice(s![1..4, 1..5]);
+        let b_off = big.slice(s![1..5, 0..3]); // [4, 3]
+        let b_off_s = big_s.slice(s![1..5, 0..3]);
+        let c3 = &a_off % &b_off;
+        let c3_ref = &a_off_s % &b_off_s;
+        assert!(allclose_f64(&c3, &c3_ref), "offset-view gemm mismatch");
+
+        // stride-2 slice
+        let a_str = big.slice(s![0..5, slice!(0, 6, 2)]); // [5, 3], col stride 2
+        let a_str_s = big_s.slice(s![0..5, slice!(0, 6, 2)]);
+        let b_str = big.slice(s![0..3, 0..4]);
+        let b_str_s = big_s.slice(s![0..3, 0..4]);
+        let c4 = &a_str % &b_str;
+        let c4_ref = &a_str_s % &b_str_s;
+        assert!(allclose_f64(&c4, &c4_ref), "stride-2 gemm mismatch");
+
+        // broadcast stride-0 column: A [3, 1] broadcast to [3, 4]
+        let a_col = arange_shape(&dev_f, [3, 1]);
+        let a_col_s = arange_shape_serial(&dev_s, [3, 1]);
+        let a_b = a_col.to_broadcast(vec![3, 4]);
+        let a_b_s = a_col_s.to_broadcast(vec![3, 4]);
+        let b42 = big.slice(s![0..4, 0..2]); // [4, 2]
+        let b42_s = big_s.slice(s![0..4, 0..2]);
+        let c5 = &a_b % &b42;
+        let c5_ref = &a_b_s % &b42_s;
+        assert!(allclose_f64(&c5, &c5_ref), "stride-0 broadcast A gemm mismatch");
+    }
