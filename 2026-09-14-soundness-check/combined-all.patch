+    fn test_col_major_default_order() {
+        // results must be independent of the device default order
+        let mut device = DeviceFaer::default();
+        device.set_default_order(RowMajor);
+        let c = as_mat(&C_MAT, [4, 4], &device);
+        let s = as_mat(&S, [4, 4], &device);
+        let l_rm = rt::linalg::cholesky((&c, Lower));
+        let w_rm = rt::linalg::eigvalsh(&s);
+
+        device.set_default_order(ColMajor);
+        // same uplo flag: identical values
+        let l_cm = rt::linalg::cholesky((&c, Lower));
+        let w_cm = rt::linalg::eigvalsh(&s);
+        assert!(max_abs_diff(&l_cm, &l_rm) < 1e-12);
+        assert!(max_abs_diff_1d(&w_cm, &w_rm) < 1e-12);
+
+        // default uplo switches with order, but the mathematical result of
+        // cholesky (lower factor) must agree when requested explicitly
+        let l_cm_default = rt::linalg::cholesky((&c, Upper));
+        assert!(max_abs_diff(&l_cm_default, &l_rm.t().to_owned()) < 1e-12);
+    }
