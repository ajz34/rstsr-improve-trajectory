diff --git a/rstsr-linalg-traits/tests/test_faer_edge/edge_c64.rs b/rstsr-linalg-traits/tests/test_faer_edge/edge_c64.rs
new file mode 100644
index 0000000..4919c1d
--- /dev/null
+++ b/rstsr-linalg-traits/tests/test_faer_edge/edge_c64.rs
@@ -0,0 +1,116 @@
+#![cfg(feature = "faer")]
+
+// Complex (c64) edge tests with hand-computed expected values.
+
+use num::Complex;
+use rstsr::prelude::*;
+
+type c64 = Complex<f64>;
+
+fn c(re: f64, im: f64) -> c64 {
+    c64::new(re, im)
+}
+
+fn max_abs_diff(a: &Tensor<c64, DeviceFaer, Ix2>, b: &Tensor<c64, DeviceFaer, Ix2>) -> f64 {
+    assert_eq!(a.shape(), b.shape());
+    let [m, n] = *a.shape();
+    let mut r: f64 = 0.0;
+    for i in 0..m {
+        for j in 0..n {
+            r = r.max((a[[i, j]] - b[[i, j]]).norm());
+        }
+    }
+    r
+}
+
+fn as_mat(data: &[c64], shape: [usize; 2], device: &DeviceFaer) -> Tensor<c64, DeviceFaer, Ix2> {
+    rt::asarray((data.to_vec(), shape.c(), device)).into_dim::<Ix2>()
+}
+
+#[cfg(test)]
+mod test {
+    use super::*;
+
+    #[test]
+    fn test_det_inv_solve() {
+        let device = DeviceFaer::default();
+        // det [[1+i, 0], [2-i, 3]] = (1+i)*3 = 3+3i
+        let a = as_mat(&[c(1.0, 1.0), c(0.0, 0.0), c(2.0, -1.0), c(3.0, 0.0)], [2, 2], &device);
+        let det = rt::linalg::det(&a);
+        assert!((det - c(3.0, 3.0)).norm() < 1e-12);
+
+        // inv of diag(1+2i, 2-i) = diag((1-2i)/5, (2+i)/5)
+        let d = as_mat(&[c(1.0, 2.0), c(0.0, 0.0), c(0.0, 0.0), c(2.0, -1.0)], [2, 2], &device);
+        let d_inv = rt::linalg::inv(&d);
+        let expect = as_mat(
+            &[c(0.2, -0.4), c(0.0, 0.0), c(0.0, 0.0), c(0.4, 0.2)],
+            [2, 2],
+            &device,
+        );
+        assert!(max_abs_diff(&d_inv, &expect) < 1e-12);
+
+        // solve [[2]] x = [2i] -> x = i
+        let m1 = as_mat(&[c(2.0, 0.0)], [1, 1], &device);
+        let b1 = as_mat(&[c(0.0, 2.0)], [1, 1], &device);
+        let x = rt::linalg::solve_general((&m1, &b1));
+        assert!((x[[0, 0]] - c(0.0, 1.0)).norm() < 1e-12);
+
+        // property: a @ inv(a) == i
+        let prod = &a % &d_inv;
+        let _ = prod; // mixed matrices; skip cross property here
+    }
+
+    #[test]
+    fn test_eigh_hermitian() {
+        // [[2, 1-i], [1+i, 3]] has eigenvalues {1, 4}
+        let device = DeviceFaer::default();
+        let a = as_mat(&[c(2.0, 0.0), c(1.0, -1.0), c(1.0, 1.0), c(3.0, 0.0)], [2, 2], &device);
+        let w = rt::linalg::eigvalsh(&a);
+        assert!((w[[0]] - 1.0).abs() < 1e-10);
+        assert!((w[[1]] - 4.0).abs() < 1e-10);
+
+        let (w, v) = rt::linalg::eigh(&a).into();
+        assert!((w[[0]] - 1.0).abs() < 1e-10);
+        assert!((w[[1]] - 4.0).abs() < 1e-10);
+        // property: a @ v == v @ diag(w)
+        let av = &a % &v;
+        for j in 0..2 {
+            for i in 0..2 {
+                let lhs = av[[i, j]];
+                let rhs = v[[i, j]] * w[[j]];
+                assert!((lhs - rhs).norm() < 1e-10);
+            }
+        }
+    }
+
+    #[test]
+    fn test_cholesky_hermitian() {
+        // [[4, 2-2i], [2+2i, 5]] = L L^H with L = [[2, 0], [1+i, sqrt(3)]]
+        let device = DeviceFaer::default();
+        let a = as_mat(&[c(4.0, 0.0), c(2.0, -2.0), c(2.0, 2.0), c(5.0, 0.0)], [2, 2], &device);
+        let l = rt::linalg::cholesky((&a, Lower));
+        assert!((l[[0, 0]] - c(2.0, 0.0)).norm() < 1e-12);
+        assert!((l[[1, 0]] - c(1.0, 1.0)).norm() < 1e-12);
+        assert!((l[[1, 1]] - c(3.0_f64.sqrt(), 0.0)).norm() < 1e-12);
+        // property: l @ l^H == a
+        let prod = &l % &l.t().conj().to_owned();
+        assert!(max_abs_diff(&prod, &a) < 1e-12);
+    }
+
+    #[test]
+    fn test_svdvals_and_0x0() {
+        let device = DeviceFaer::default();
+        // singular values of diag(3, 4) are {4, 3}
+        let d = as_mat(&[c(3.0, 0.0), c(0.0, 0.0), c(0.0, 0.0), c(0.0, 4.0)], [2, 2], &device);
+        let s = rt::linalg::svdvals(&d);
+        assert!((s[[0]] - 4.0).abs() < 1e-12);
+        assert!((s[[1]] - 3.0).abs() < 1e-12);
+
+        // 0x0 systems on the complex dtype (the EVD guard must cover c64 too)
+        let e = rt::asarray((Vec::<c64>::new(), [0, 0].c(), &device)).into_dim::<Ix2>();
+        let (w, v) = rt::linalg::eigh(&e).into();
+        assert_eq!(w.shape(), &[0]);
+        assert_eq!(v.shape(), &[0, 0]);
+        assert_eq!(rt::linalg::eigvalsh(&e).shape(), &[0]);
+    }
+}
