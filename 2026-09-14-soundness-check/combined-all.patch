+    #[test]
+    fn test_gemm_batch_parallel_and_serial_paths() {
+        // exercise both the parallel-outer (`n_task > 4 * nthreads`) and the
+        // sequential-outer broadcast paths with odd rest-dim shapes.
+        let dev_f = device_faer_row_major();
+        let dev_s = device_serial_row_major();
+
+        // parallel-outer path: 3*37 = 111 tasks > 4 * nthreads (16 cores);
+        // A's batch dims broadcast against B's ([1, 37] -> [3, 37]).
+        let a = arange((0.0, 1.0 * 37.0 * 5.0 * 7.0, 1.0, &dev_f)).into_shape([1, 37, 5, 7]);
+        let b = arange((0.0, 3.0 * 37.0 * 7.0 * 4.0, 1.0, &dev_f)).into_shape([3, 37, 7, 4]);
+        let c = &a % &b;
+        let a_s = arange((0.0, 1.0 * 37.0 * 5.0 * 7.0, 1.0, &dev_s)).into_shape([1, 37, 5, 7]);
+        let b_s = arange((0.0, 3.0 * 37.0 * 7.0 * 4.0, 1.0, &dev_s)).into_shape([3, 37, 7, 4]);
+        let c_ref = &a_s % &b_s;
+        assert_eq!(c.shape(), &[3, 37, 5, 4]);
+        assert!(allclose_f64(&c, &c_ref), "rule-7 parallel-outer mismatch");
+
+        // sequential-outer path: n_task <= 4 * nthreads
+        let a2 = arange((0.0, 2.0 * 3.0 * 3.0 * 4.0, 1.0, &dev_f)).into_shape([2, 3, 3, 4]);
+        let b2 = arange((0.0, 2.0 * 3.0 * 4.0 * 5.0, 1.0, &dev_f)).into_shape([2, 3, 4, 5]);
+        let c2 = &a2 % &b2;
+        let a2_s = arange((0.0, 2.0 * 3.0 * 3.0 * 4.0, 1.0, &dev_s)).into_shape([2, 3, 3, 4]);
+        let b2_s = arange((0.0, 2.0 * 3.0 * 4.0 * 5.0, 1.0, &dev_s)).into_shape([2, 3, 4, 5]);
+        let c2_ref = &a2_s % &b2_s;
+        assert!(allclose_f64(&c2, &c2_ref), "rule-7 sequential-outer mismatch");
+
+        // single-threaded device must agree too
+        let mut dev_f1 = DeviceFaer::new(1);
+        dev_f1.set_default_order(RowMajor);
+        let c3 = {
+            let a3 = arange((0.0, 1.0 * 37.0 * 5.0 * 7.0, 1.0, &dev_f1)).into_shape([1, 37, 5, 7]);
+            let b3 = arange((0.0, 3.0 * 37.0 * 7.0 * 4.0, 1.0, &dev_f1)).into_shape([3, 37, 7, 4]);
+            &a3 % &b3
+        };
+        assert!(allclose_f64(&c3, &c_ref), "rule-7 single-thread mismatch");
