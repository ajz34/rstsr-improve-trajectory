@@ -0,0 +1,108 @@
+//! Iteration, flattening, indexing, and slicing under col-major layouts.
+
+use super::*;
+
+#[test]
+fn test_iter_f_contig_is_buffer_order() {
+    let device = col_dev();
+    let a = rt::arange((6, &device)).into_shape([2, 3]);
+    // col-major logical reading of an F-contiguous tensor == buffer order
+    assert_eq!(a.iter().copied().collect::<Vec<_>>(), vec![0, 1, 2, 3, 4, 5]);
+    // reshape(-1) needs no copy and reads in the same order
+    let flat = a.reshape(-1);
+    assert!(!flat.is_owned());
+    assert_eq!(flat.to_vec(), vec![0, 1, 2, 3, 4, 5]);
+}
+
+#[test]
+fn test_iter_c_layout_reads_col_major() {
+    let device = col_dev();
+    let c = rt::asarray((vec![0., 1., 2., 3., 4., 5.], [2, 3].c(), &device));
+    // iteration follows the device default order (col-major traversal), so a
+    // C-contiguous tensor is read out of buffer order
+    assert_eq!(c.iter().copied().collect::<Vec<_>>(), vec![0.0, 3.0, 1.0, 4.0, 2.0, 5.0]);
+    // reshape(-1) must copy (the C layout is not col-major contiguous)
+    let flat = c.reshape(-1);
+    assert!(flat.is_owned());
+    assert_eq!(flat.to_vec(), vec![0.0, 3.0, 1.0, 4.0, 2.0, 5.0]);
+}
+
+#[test]
+fn test_iter_transposed_view() {
+    let device = col_dev();
+    let t3 = rt::arange((24, &device)).into_shape([2, 3, 4]);
+    let tv = t3.t(); // [4, 3, 2]
+    // transposing swaps the logical axes; col-major reading of the transpose
+    // walks the last (previously first) axis fastest
+    assert_eq!(tv.iter().take(6).copied().collect::<Vec<_>>(), vec![0, 6, 12, 18, 2, 8]);
+}
+
+#[test]
+fn test_iter_3d_noncontig_slice() {
+    let device = col_dev();
+    let t3 = rt::arange((24, &device)).into_shape([2, 3, 4]);
+    // drop the middle axis to 2 columns: stride [1, 2, 6], still readable in
+    // col-major order without copy
+    let sl = t3.clone().into_slice((.., 0..2, ..));
+    assert_eq!(sl.stride(), &[1, 2, 6]);
+    assert_eq!(
+        sl.iter().copied().collect::<Vec<_>>(),
+        vec![0, 1, 2, 3, 6, 7, 8, 9, 12, 13, 14, 15, 18, 19, 20, 21]
+    );
+}
+
+#[test]
+fn test_partially_contiguous_slice() {
+    let device = col_dev();
+    let t3 = rt::arange((24, &device)).into_shape([2, 3, 4]);
+    // (.., .., 0) keeps a contiguous run over the two leading axes
+    let sl2 = t3.clone().into_slice((.., .., 0));
+    assert_eq!(sl2.shape(), &[2, 3]);
+    assert_eq!(sl2.stride(), &[1, 2]);
+    assert_eq!(sl2.iter().copied().collect::<Vec<_>>(), vec![0, 1, 2, 3, 4, 5]);
+}
+
+#[test]
+fn test_indexing_logical_indices() {
+    let device = col_dev();
+    let a = rt::arange((6, &device)).into_shape([2, 3]);
+    // logical (i, j) = i + 2j under col packing
+    assert_eq!(a[[0, 2]], 4);
+    assert_eq!(a[[1, 0]], 1);
+    assert_eq!(a[[1, 2]], 5);
+}
+
+#[test]
+fn test_slicing_steps_and_negative() {
+    let device = col_dev();
+    let a = rt::arange((12, &device)).into_shape([3, 4]);
+    // logical matrix rows: [0, 4, 8, 12? no: (i, j) = i + 3j] -> [0, 3, 6, 9] etc.
+    let sl = a.i((.., 0..3)); // drop last column
+    assert_eq!(sl.shape(), &[3, 3]);
+    assert_eq!(sl[[0, 0]], 0);
+    assert_eq!(sl[[2, 2]], 2 + 3 * 2);
+    // negative index selects from the end
+    let last_row = a.i(-1);
+    assert_eq!(last_row.shape(), &[4]);
+    assert_eq!(last_row.to_vec(), vec![2, 5, 8, 11]);
+}
+
+#[test]
+fn test_index_select_col_semantics() {
+    let device = col_dev();
+    let a = rt::arange((6, &device)).into_shape([3, 2]);
+    // logical: [[0, 3], [1, 4], [2, 5]]
+    let b = a.index_select(0, [0, 2]);
+    assert_eq!(b.shape(), &[2, 2]);
+    assert_eq!((b[[0, 0]], b[[0, 1]], b[[1, 0]], b[[1, 1]]), (0, 3, 2, 5));
+}
+
+#[test]
+fn test_index_mut_write_through_layout() {
+    let device = col_dev();
+    let mut a = rt::arange((6, &device)).into_shape([2, 3]).into_owned();
+    a[[1, 2]] = 100;
+    // the write lands where the col-major layout says: buffer offset 1 + 2*2 = 5
+    assert_eq!(a.raw()[5], 100);
+    assert_eq!(a[[0, 0]], 0);
+}
diff --git a/rstsr-core/tests/col_func/test_manipulation_order.rs b/rstsr-core/tests/col_func/test_manipulation_order.rs
