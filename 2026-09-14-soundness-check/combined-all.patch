+    use crate::prelude::rt;
+
+    fn device_faer_row_major() -> DeviceFaer {
+        let mut device = DeviceFaer::default();
+        device.set_default_order(RowMajor);
+        device
+    }
+
+    fn device_faer_col_major() -> DeviceFaer {
+        let mut device = DeviceFaer::default();
+        device.set_default_order(ColMajor);
+        device
+    }
+
+    fn device_serial_row_major() -> DeviceCpuSerial {
+        let mut device = DeviceCpuSerial::default();
+        device.set_default_order(RowMajor);
+        device
+    }
+
+    /// `arange`-based deterministic 2-D tensor of the requested shape.
+    fn arange_shape(device: &DeviceFaer, shape: [usize; 2]) -> Tensor<f64, DeviceFaer, IxD> {
+        let (m, k) = (shape[0], shape[1]);
+        arange((0.0, (m * k) as f64, 1.0, device)).into_shape([m, k])
+    }
+
+    fn arange_shape_serial(device: &DeviceCpuSerial, shape: [usize; 2]) -> Tensor<f64, DeviceCpuSerial, IxD> {
+        let (m, k) = (shape[0], shape[1]);
+        arange((0.0, (m * k) as f64, 1.0, device)).into_shape([m, k])
+    }
