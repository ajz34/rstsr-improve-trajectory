+    #[test]
+    fn test_gemm_edge_shapes_row_major() {
+        // faer must agree with the naive serial implementation on degenerate
+        // shapes: zero-sized axes, 1x1 gemms, gemv-like extremes, and odd
+        // non-multiples of internal block sizes.
+        let shapes = [
+            [0usize, 0],
+            [1, 1],
+            [3, 0], // K = 0 (A [m, 0] @ B [0, n])
+            [0, 4], // M = 0
+            [1, 9],
+            [9, 1],
+            [2, 3],
+            [7, 13],
+            [17, 19],
+            [31, 2],
+        ];
+        for shape_a in shapes {
+            for shape_b in [[0usize, 2], [1, 1], [2, 5], [4, 3], [8, 8]] {
+                let dev_f = device_faer_row_major();
+                let dev_s = device_serial_row_major();
+                let (m, k) = (shape_a[0], shape_a[1]);
+                if shape_b[0] != k {
+                    continue; // only compatible (m, k) @ (k, n) pairs
+                }
+                let n = shape_b[1];
+                let a = arange_shape(&dev_f, shape_a);
+                let b = arange_shape(&dev_f, shape_b);
+                let a_s = arange_shape_serial(&dev_s, shape_a);
+                let b_s = arange_shape_serial(&dev_s, shape_b);
+                let c = &a % &b;
+                let c_ref = &a_s % &b_s;
+                assert_eq!(c.shape(), &[m, n]);
+                assert_eq!(c_ref.shape(), &[m, n]);
+                assert!(
+                    allclose_f64(&c, &c_ref),
+                    "mismatch for shape ({m},{k}) @ ({k},{n}):\nfaer: {c}\nserial: {c_ref}"
+                );
+            }
+        }
+    }
