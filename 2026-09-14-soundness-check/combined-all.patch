+    #[test]
+    fn test_1x1_systems() {
+        let device = DeviceFaer::default();
+        let one = as_mat(&[3.5], [1, 1], &device);
+        assert!((rt::linalg::det(&one) - 3.5).abs() < 1e-12);
+        assert!((rt::linalg::inv(&one)[[0, 0]] - 1.0 / 3.5).abs() < 1e-12);
+        assert!((rt::linalg::svdvals(&one).raw()[0] - 3.5).abs() < 1e-12);
+        assert!((rt::linalg::eigvalsh(&one).raw()[0] - 3.5).abs() < 1e-12);
+        let l = rt::linalg::cholesky((&one, Lower));
+        assert!((l[[0, 0]] - 3.5_f64.sqrt()).abs() < 1e-12);
+        // solve [[2]] x = [6]
+        let m1 = as_mat(&[2.0], [1, 1], &device);
+        let b1 = as_mat(&[6.0], [1, 1], &device);
+        let x = rt::linalg::solve_general((&m1, &b1));
+        assert!((x[[0, 0]] - 3.0).abs() < 1e-12);
+    }
