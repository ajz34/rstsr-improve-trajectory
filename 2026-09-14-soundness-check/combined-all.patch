+        // property: r2 @ pinv @ r2 == r2 (Moore-Penrose)
+        let tmp = &r2 % &pinv;
+        let recon = &tmp % &r2;
+        assert!(max_abs_diff(&recon, &r2) < 1e-8);
+    }
