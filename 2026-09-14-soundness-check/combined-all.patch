+        assert!((rt::linalg::det(&e) - 1.0).abs() < 1e-12);
+        assert_eq!(rt::linalg::inv(&e).shape(), &[0, 0]);
+        assert_eq!(rt::linalg::solve_general((&e, &e)).shape(), &[0, 0]);
