@@ -0,0 +1,295 @@
+//! The naive driver: a universal elementwise GEMM kernel.
+//!
+//! One thread per output element, a loop over the contraction, full layout addressing (signed and
+//! zero strides, per-axis batch strides). It serves every type triple of [`NaiveScalar`] and every
+//! layout the rule table admits, and it is the last driver of the chain: whatever the accelerated
+//! drivers decline lands here. It is also the on-device oracle for them.
+//!
+//! The arithmetic is deliberately simple. Each operand is cast to the accumulator type `@TACC@`
+//! (`f32` for a half output, the output type otherwise), the `k` products are added in `@TACC@`,
+//! and the sum is rounded to the output type once. A mixed triple is therefore a "cast each
+//! operand to the output type" promotion, with no materialized copy. The result is exact for
+//! integer triples and within one rounding of the CPU serial kernel for the real ones; it is
+//! DRAM-bound, which is why it runs last.
+//!
+//! Nothing is declined here. An empty output returns before any driver is asked, and the two
+//! shapes that have no GEMM geometry at all (the inner dot; a batch rank over [`RANK_MAX`]) are
+//! refused by name before the chain.
+
+use super::super::geom::CallerGeom;
+use super::{Problem, Verdict};
+use crate::dtype::{is_complex_cname, is_half_cname, CudaDType};
+use crate::kernel::{order_input, order_output, FlatLaunch};
+use crate::kernels::elementwise::planned_function;
+use crate::kernels::exprs::{compute_type, load};
+use crate::prelude_dev::*;
+
+/// Largest batch rank (number of axes in front of the two matrix axes) the kernel is generated
+/// for; the batch shape and stride arrays of all three operands are padded to this rank.
+const RANK_MAX: usize = 16;
+
+/// Types the naive kernel is instantiated for: everything with CUDA C arithmetic and a zero.
+pub(crate) trait NaiveScalar: CudaDType + num::Zero {
+    /// C type the products are accumulated in: `float` for a half output, else the type itself.
+    fn acc() -> &'static str {
+        if is_half_cname(Self::CNAME) {
+            "float"
+        } else {
+            Self::CNAME
+        }
+    }
+}
+
+impl<T: CudaDType + num::Zero> NaiveScalar for T {}
+
+/// C expression of the zero value of C type `t`.
+fn zero_expr(t: &str) -> String {
+    if is_complex_cname(t) {
+        format!("{t}(0.0f, 0.0f)")
+    } else if is_half_cname(t) {
+        // the half conversion helper: `( __half )0` is not a valid half zero
+        crate::kernels::exprs::store(t, "0.0f")
+    } else {
+        format!("({t})0")
+    }
+}
+
+/// C expression of `x` (of C type `from`) cast to C type `to`.
+///
+/// `x` is a real scalar or a value already of type `to`. Real to complex is `to(x, 0)`; the
+/// reverse never occurs (no promotion produces a real output from a complex operand).
+fn cast(from: &str, to: &str, x: &str) -> String {
+    if from == to {
+        return x.to_string();
+    }
+    if is_half_cname(to) {
+        crate::kernels::exprs::store(to, x)
+    } else if is_complex_cname(to) {
+        format!("{to}({x}, 0.0f)")
+    } else {
+        format!("({to})({x})")
+    }
+}
+
+/// The C expression of one product term, in the accumulator type.
+fn term(ta: &str, tb: &str, tacc: &str, a: &str, b: &str) -> String {
+    let (lta, ltb) = (compute_type(ta), compute_type(tb));
+    let av = cast(&lta, tacc, &load(ta, a));
+    let bv = cast(&ltb, tacc, &load(tb, b));
+    format!("{av} * {bv}")
+}
+
+/// The C expression of the scaled sum, and of the epilogue `v + beta * *p`.
+fn epilogue(tc: &str) -> (String, String) {
+    if is_half_cname(tc) {
+        // `alpha` and `beta` are half, `acc` is float: compute the epilogue in float, store once
+        (
+            crate::kernels::exprs::store(tc, "__half2float(alpha) * acc"),
+            "__float2half(__half2float(v) + __half2float(beta) * __half2float(*p))".to_string(),
+        )
+    } else {
+        ("alpha * acc".to_string(), "v + beta * (*p)".to_string())
+    }
+}
+
+const NAIVE_ENTRY: &str = r#"
+typedef struct { int n[@R@]; } rstsr_bsh;
+typedef struct { rstsr_isz s[@R@]; } rstsr_bst;
+
+extern "C" __global__ void rstsr_matmul_naive(
+    @TC@* c, const @TA@* a, const @TB@* b,
+    rstsr_isz scm, rstsr_isz scn, rstsr_isz sam, rstsr_isz sak, rstsr_isz sbk, rstsr_isz sbn,
+    rstsr_usz total, rstsr_isz M, rstsr_isz N, rstsr_isz K,
+    rstsr_bsh bsh_a, rstsr_bst bst_a,
+    rstsr_bsh bsh_b, rstsr_bst bst_b,
+    rstsr_bsh bsh_c, rstsr_bst bst_c,
+    int read_c, @TC@ alpha, @TC@ beta)
+{
+    rstsr_usz t = (rstsr_usz)blockIdx.x * blockDim.x + threadIdx.x;
+    if (t >= total) return;
+    rstsr_usz r = t / (rstsr_usz)N;
+    rstsr_isz j = (rstsr_isz)(t - r * (rstsr_usz)N);
+    rstsr_usz bi = r / (rstsr_usz)M;
+    rstsr_isz i = (rstsr_isz)(r - bi * (rstsr_usz)M);
+
+    // batch offset of this slice, decomposed against each operand's own batch shape
+    rstsr_isz oa = 0, ob = 0, oc = 0;
+    rstsr_usz ia = bi, ib = bi, ic = bi;
+    #pragma unroll
+    for (int d = @R@ - 1; d >= 0; --d) {
+        oc += (rstsr_isz)(ic % (rstsr_usz)bsh_c.n[d]) * bst_c.s[d]; ic /= (rstsr_usz)bsh_c.n[d];
+        oa += (rstsr_isz)(ia % (rstsr_usz)bsh_a.n[d]) * bst_a.s[d]; ia /= (rstsr_usz)bsh_a.n[d];
+        ob += (rstsr_isz)(ib % (rstsr_usz)bsh_b.n[d]) * bst_b.s[d]; ib /= (rstsr_usz)bsh_b.n[d];
+    }
+
+    const @TA@* ap = a + oa;
+    const @TB@* bp = b + ob;
+    @TACC@ acc = @ZERO@;
+    for (rstsr_isz kk = 0; kk < K; ++kk) {
+        acc += @TERM@;
+    }
+    @TC@* p = c + oc + i * scm + j * scn;
+    const @TC@ v = @VALUE@;
+    *p = read_c ? (@ADD_C@) : v;
+}
+"#;
+
+/// Batch shape and stride arrays of one operand, padded with leading unit extents.
+fn batch_arrays(part: &crate::matmul::geom::BatchPart, rank: usize) -> (Vec<i32>, Vec<isize>) {
+    let pad = rank - part.shape.len();
+    let shape = part.shape.iter().map(|&n| n as i32);
+    let stride = part.stride.iter().copied();
+    let ones = std::iter::repeat_n(1i32, pad);
+    let zeros = std::iter::repeat_n(0isize, pad);
+    (ones.chain(shape).collect(), zeros.chain(stride).collect())
+}
+
+fn bytes_i32(v: &[i32]) -> Vec<u8> {
+    v.iter().flat_map(|x| x.to_ne_bytes()).collect()
+}
+
+fn bytes_isize(v: &[isize]) -> Vec<u8> {
+    v.iter().flat_map(|x| x.to_ne_bytes()).collect()
+}
+
+/// Run the problem on the naive kernel. Errors are launch failures.
+pub(super) fn run<TA, TB, TC, TBuf>(p: &Problem<'_, TA, TB, TC, TBuf>) -> Result<Verdict>
+where
+    TA: NaiveScalar,
+    TB: NaiveScalar,
+    TC: NaiveScalar,
+    TBuf: 'static,
+{
+    // The caller's roles, not the row-major ones: the kernel is templated on the caller's types.
+    let CallerGeom { mnk, a, b, c, batch } = p.geom.caller();
+    let (a_off, sam, sak) = a;
+    let (b_off, sbk, sbn) = b;
+    let (c_off, scm, scn) = c;
+    let rank = batch.iter().map(|part| part.shape.len()).max().unwrap_or(0);
+    if rank > RANK_MAX {
+        rstsr_raise!(
+            UnImplemented,
+            "cuda matmul: the batch part has rank {rank}, over the limit of {RANK_MAX} of the naive kernel"
+        )?
+    }
+    let rank = rank.max(1);
+    let (sh_a, st_a) = batch_arrays(batch[0], rank);
+    let (sh_b, st_b) = batch_arrays(batch[1], rank);
+    let (sh_c, st_c) = batch_arrays(batch[2], rank);
+
+    let ta = TA::CNAME;
+    let tb = TB::CNAME;
+    let tc = TC::CNAME;
+    let tacc = TC::acc();
+    let (value, add_c) = epilogue(tc);
+    let subs: Vec<(&str, String)> = vec![
+        ("@TA@", ta.to_string()),
+        ("@TB@", tb.to_string()),
+        ("@TC@", tc.to_string()),
+        ("@TACC@", tacc.to_string()),
+        ("@R@", rank.to_string()),
+        ("@ZERO@", zero_expr(tacc)),
+        ("@TERM@", term(ta, tb, tacc, "ap[i * sam + kk * sak]", "bp[kk * sbk + j * sbn]")),
+        ("@VALUE@", value),
+        ("@ADD_C@", add_c),
+    ];
+    let source = subs.iter().fold(NAIVE_ENTRY.to_string(), |s, (k, v)| s.replace(k, v));
+    let mut includes: Vec<&'static str> = Vec::new();
+    for inc in TA::INCLUDES.iter().chain(TB::INCLUDES).chain(TC::INCLUDES) {
+        includes.push(inc);
+    }
+    let disc = format!("{ta}|{tb}|{tc}|{tacc}|R{rank}");
+    let f = planned_function(p.device, "rstsr_matmul_naive", &includes, &disc, || source)?;
+
+    let exec = p.device.stream();
+    let _ga = order_input(p.a, exec)?;
+    let _gb = order_input(p.b, exec)?;
+    let _gc = order_output(p.c, exec)?;
+    let total = p.geom.n_batch as u64 * p.geom.m as u64 * p.geom.n as u64;
+    let abytes = super::scalar_bytes(&p.alpha);
+    let bbytes = super::scalar_bytes(&p.beta);
+    let nb = core::mem::size_of::<TC>();
+
+    FlatLaunch::new(exec, &f, total as usize)
+        .arg_ptr(p.c, c_off)
+        .arg_ptr(p.a, a_off)
+        .arg_ptr(p.b, b_off)
+        .arg_bytes(&scm.to_ne_bytes())
+        .arg_bytes(&scn.to_ne_bytes())
+        .arg_bytes(&sam.to_ne_bytes())
+        .arg_bytes(&sak.to_ne_bytes())
+        .arg_bytes(&sbk.to_ne_bytes())
+        .arg_bytes(&sbn.to_ne_bytes())
+        .arg_u64(total)
+        .arg_bytes(&(mnk.0 as isize).to_ne_bytes())
+        .arg_bytes(&(mnk.2 as isize).to_ne_bytes())
+        .arg_bytes(&(mnk.1 as isize).to_ne_bytes())
+        .arg_bytes(&bytes_i32(&sh_a))
+        .arg_bytes(&bytes_isize(&st_a))
+        .arg_bytes(&bytes_i32(&sh_b))
+        .arg_bytes(&bytes_isize(&st_b))
+        .arg_bytes(&bytes_i32(&sh_c))
+        .arg_bytes(&bytes_isize(&st_c))
+        .arg_i32(p.read_c as i32)
+        .arg_bytes(&abytes[..nb])
+        .arg_bytes(&bbytes[..nb])
+        .launch()?;
+
+    Ok(Verdict::Ran)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// The accumulator is the output type, except for half outputs which accumulate in `f32`.
+    #[test]
+    fn accumulator_type() {
+        assert_eq!(f32::acc(), "float");
+        assert_eq!(f64::acc(), "double");
+        assert_eq!(i32::acc(), "int");
+        assert_eq!(num::Complex::<f64>::acc(), "rstsr_c64");
+        assert_eq!(half::f16::acc(), "float");
+        assert_eq!(half::bf16::acc(), "float");
+    }
+
+    /// The cast rule: identity, real to real, real to complex, and the half conversions.
+    #[test]
+    fn casts() {
+        assert_eq!(cast("float", "float", "x"), "x");
+        assert_eq!(cast("float", "double", "x"), "(double)(x)");
+        assert_eq!(cast("double", "rstsr_c64", "x"), "rstsr_c64(x, 0.0f)");
+        // a half operand is loaded as float first, so the cast that follows is the float one
+        assert_eq!(cast(&compute_type("__half"), "double", "__half2float(x)"), "(double)(__half2float(x))");
+        assert_eq!(term("__half", "float", "double", "a0", "b0"), "(double)(__half2float(a0)) * (double)(b0)");
+        assert_eq!(cast("float", "__half", "x"), "__float2half(x)");
+        assert_eq!(zero_expr("int"), "(int)0");
+        assert_eq!(zero_expr("rstsr_c32"), "rstsr_c32(0.0f, 0.0f)");
+        assert_eq!(zero_expr("__nv_bfloat16"), "__float2bfloat16(0.0f)");
+    }
+
+    /// The batch arrays are padded with leading unit extents, so a lower-rank operand decomposes
+    /// its slice index against its own trailing axes.
+    #[test]
+    fn batch_arrays_pad_leading() {
+        let part = crate::matmul::geom::BatchPart { shape: vec![2, 3], stride: vec![30, 10] };
+        assert_eq!(batch_arrays(&part, 2), (vec![2, 3], vec![30, 10]));
+        assert_eq!(batch_arrays(&part, 4), (vec![1, 1, 2, 3], vec![0, 0, 30, 10]));
+        let none = crate::matmul::geom::BatchPart::default();
+        assert_eq!(batch_arrays(&none, 2), (vec![1, 1], vec![0, 0]));
+    }
+
+    /// Every type the driver claims is covered by the trait.
+    #[test]
+    fn naive_scalar_coverage() {
+        fn is_naive<T: NaiveScalar>() {}
+        is_naive::<f32>();
+        is_naive::<f64>();
+        is_naive::<i8>();
+        is_naive::<u64>();
+        is_naive::<num::Complex<f32>>();
+        is_naive::<num::Complex<f64>>();
+        is_naive::<half::f16>();
+        is_naive::<half::bf16>();
+    }
+}
diff --git a/crates-device/rstsr-cuda/src/matmul/drivers/tiled.rs b/crates-device/rstsr-cuda/src/matmul/drivers/tiled.rs
new file mode 100644
index 0000000..37c8f17
--- /dev/null
+++ b/crates-device/rstsr-cuda/src/matmul/drivers/tiled.rs
@@ -0,0 +1,375 @@
+//! The tiled SIMT GEMM driver — the kernel behind `matmul` when cuBLAS declines.
+//!
+//! It takes what the classic cuBLAS entries cannot express (a stepped output, a reversed
+//! operand) and a machine without `libcublas`, and it is the on-device step before the naive
+//! kernel. It is kept for those cases and as a test oracle, not because it competes — on an A100,
+//! `dgemm` reaches the FP64 tensor-core pipe at 19.5 TFLOPS where a SIMT tile tops out at 9.7.
+//!
+//! # What this kernel is
+//!
+//! One block computes a `BM x BN` tile of `C = alpha * A B + beta * C` by streaming the contraction
+//! axis through shared memory in `BK`-deep slabs. Per block that is `BM*BN*K` fused multiply-adds
+//! for `(BM+BN)*K` element loads, i.e. `2*64*64 / (128*8) = 8` flop/byte once the tile is resident.
+//! The untiled form is `2/16 = 0.125`, which is DRAM-bound on every machine — the whole reason this
+//! file exists.
+//!
+//! 8 flop/byte is only just above the A100 fp64 ridge point (`9.7 TFLOPS / 1.55 TB/s` = 6.3), so at
+//! this tile size the kernel is *marginally* compute-bound and the memory system still costs nearly
+//! as much as the arithmetic. Doubling the tile to 128x128 gives `2*128*128 / (256*8) = 16` and is
+//! the first thing to try after measuring this one; `BM`/`BN` are plain constants and every derived
+//! count (slab depth, thread count, shared sizes) follows from them, so the change is a re-tune
+//! rather than a rewrite.
+//!
+//! # The two things that are actually decisions
+//!
+//! **1. The lane map follows a unit-stride axis, not a fixed axis.** A 2-D operand arrives with
+//! arbitrary strides: `A` may be `[M, K]` with `K` contiguous (`rt::matmul(a, b)`) or with `M`
+//! contiguous (`rt::matmul(a.T, b)`), and `layout_matmul` admits both because it only checks
+//! shapes. Instead of transposing an operand — a copy — the block's linear thread id is mapped to
+//! the tile along whichever axis is unit-stride, chosen at **NVRTC time**. Four variants result (A
+//! on `k` or `m`, B on `k` or `n`) and each has both global loads coalesced.
+//!
+//! **2. Per-thread tiles are interleaved, not blocked.** Thread `(tx, ty)` owns rows `ty + i*TY`
+//! and columns `tx + j*TX`, so one shared-memory read instruction has its 16 lanes on 16
+//! consecutive doubles (and the other row group in the warp reads the same address, which
+//! broadcasts). Blocking would instead make the `Bs` read stride `TN` doubles per lane — a 4-way
+//! bank conflict on every one of the `TM*TN*BK` inner reads. Interleaving costs something on the
+//! store side, but not bandwidth: for a fixed `(i, j)` the 16 lanes span 16 sectors holding 8
+//! useful bytes each, and the four values of `j` then fill those same sectors, so all the bytes are
+//! consumed — the request count is 4x, not the traffic. Staging `C` through shared memory is the
+//! fix if that ever measures badly.
+//!
+//! # Order
+//!
+//! `ColMajor` is not special-cased in the kernel. The geometry module reverses every layout and
+//! swaps the operands for that order, so the kernel only ever sees row-major-decomposed blocks with
+//! leading dimensions.
+//!
+//! # What is deliberately absent
+//!
+//! No double buffering, no 128-bit vectorised loads, no `C` staging, no split-K, no cuBLAS. Batch
+//! axes ride in `grid.z` and must be *affine* (one step per operand); a non-affine batch, like an
+//! operand with no unit-stride axis, is declined here and runs on the naive driver.
+//!
+//! The kernel is single-`@T@` (it spells its zero as `(@T@)0`), so it serves `f32` and `f64` only.
+
+use std::any::TypeId;
+
+use super::super::geom::GemmGeom;
+use super::{Problem, Refusal, Uniform, Verdict};
+use crate::dtype::CudaDType;
+use crate::kernel::{order_input, order_output, FlatLaunch};
+use crate::kernels::elementwise::planned_function;
+use crate::prelude_dev::*;
+
+/// Tile of `C` computed by one block.
+const BM: u32 = 64;
+const BN: u32 = 64;
+/// Depth of one shared-memory slab along the contraction.
+const BK: u32 = 16;
+/// Outputs per thread, per axis.
+const TM: u32 = 4;
+const TN: u32 = 4;
+const TX: u32 = BN / TN;
+const TY: u32 = BM / TM;
+const NTHREADS: u32 = TX * TY;
+
+/// Elements per thread when filling one slab: `BM*BK` and `BK*BN` over the block size.
+const A_SLAB: u32 = BM * BK / NTHREADS;
+const B_SLAB: u32 = BK * BN / NTHREADS;
+
+const _: () = assert!(TX * TY == 256, "the block must be 256 threads");
+const _: () = assert!(BM * BK % NTHREADS == 0 && BK * BN % NTHREADS == 0);
+const _: () = assert!(TM * TY == BM && TN * TX == BN);
+
+/// Which axis of a 2-D operand the linear thread id enumerates.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum LaneAxis {
+    /// Contraction axis (`k`).
+    K,
+    /// The other one: `m` for the left operand, `n` for the right.
+    Other,
+}
+
+const GEMM_ENTRY: &str = r#"
+extern "C" __global__ void rstsr_gemm(
+    @T@* c,     rstsr_isz scm, rstsr_isz scn, rstsr_isz scb,
+    const @T@* a, rstsr_isz sam, rstsr_isz sak, rstsr_isz sab,
+    const @T@* b, rstsr_isz sbk, rstsr_isz sbn, rstsr_isz sbb,
+    int M, int N, int K,
+    @T@ alpha, @T@ beta)
+{
+    __shared__ @T@ As[@BK@][@BM@ + 1];
+    __shared__ @T@ Bs[@BK@][@BN@ + 1];
+
+    const int m0 = (int)blockIdx.y * @BM@;
+    const int n0 = (int)blockIdx.x * @BN@;
+    const int tid = (int)threadIdx.y * @TX@ + (int)threadIdx.x;
+    const int tx = (int)threadIdx.x;
+    const int ty = (int)threadIdx.y;
+
+    // batch: one grid slice per output matrix, affine in the slice index
+    const @T@* ap = a + (rstsr_isz)blockIdx.z * sab;
+    const @T@* bp = b + (rstsr_isz)blockIdx.z * sbb;
+    @T@*       cp = c + (rstsr_isz)blockIdx.z * scb;
+
+    @T@ acc[@TM@][@TN@];
+    #pragma unroll
+    for (int i = 0; i < @TM@; ++i)
+        #pragma unroll
+        for (int j = 0; j < @TN@; ++j) acc[i][j] = (@T@)0;
+
+    for (int k0 = 0; k0 < K; k0 += @BK@) {
+        // A slab, [BM x BK], stored transposed as As[k][m] so the inner loop reads one shared
+        // double per (i, k) instead of a strided column.
+        #pragma unroll
+        for (int t = 0; t < @A_SLAB@; ++t) {
+            rstsr_usz lin = (rstsr_usz)(tid + t * @NTHREADS@);
+            @A_IDX@
+            const int gm = m0 + (int)mm;
+            const int gk = k0 + (int)kk;
+            As[kk][mm] = (gm < M && gk < K)
+                ? ap[(rstsr_isz)gm * sam + (rstsr_isz)gk * sak]
+                : (@T@)0;
+        }
+        // B slab, [BK x BN], stored as Bs[k][n].
+        #pragma unroll
+        for (int t = 0; t < @B_SLAB@; ++t) {
+            rstsr_usz lin = (rstsr_usz)(tid + t * @NTHREADS@);
+            @B_IDX@
+            const int gk = k0 + (int)kk;
+            const int gn = n0 + (int)nn;
+            Bs[kk][nn] = (gk < K && gn < N)
+                ? bp[(rstsr_isz)gk * sbk + (rstsr_isz)gn * sbn]
+                : (@T@)0;
+        }
+        __syncthreads();
+
+        #pragma unroll
+        for (int kk = 0; kk < @BK@; ++kk) {
+            @T@ av[@TM@], bv[@TN@];
+            #pragma unroll
+            for (int i = 0; i < @TM@; ++i) av[i] = As[kk][ty + i * @TY@];
+            #pragma unroll
+            for (int j = 0; j < @TN@; ++j) bv[j] = Bs[kk][tx + j * @TX@];
+            #pragma unroll
+            for (int i = 0; i < @TM@; ++i)
+                #pragma unroll
+                for (int j = 0; j < @TN@; ++j) acc[i][j] += av[i] * bv[j];
+        }
+        __syncthreads();
+    }
+
+    // `beta == 0` must not read `c`: that is the contract of `matmul_uninit`, whose buffer is
+    // `MaybeUninit` and has no meaningful contents.
+    #pragma unroll
+    for (int i = 0; i < @TM@; ++i) {
+        const int gm = m0 + ty + i * @TY@;
+        if (gm >= M) continue;
+        #pragma unroll
+        for (int j = 0; j < @TN@; ++j) {
+            const int gn = n0 + tx + j * @TX@;
+            if (gn >= N) continue;
+            @T@* p = cp + (rstsr_isz)gm * scm + (rstsr_isz)gn * scn;
+            *p = (beta == (@T@)0) ? (alpha * acc[i][j]) : (alpha * acc[i][j] + beta * (*p));
+        }
+    }
+}
+"#;
+
+fn render(template: &str, subs: &[(&str, &str)]) -> String {
+    let mut s = template.to_string();
+    for (name, text) in subs {
+        s = s.replace(name, text);
+    }
+    s
+}
+
+/// Pick the axis the linear thread id enumerates, preferring a unit-stride one.
+///
+/// `s_other`/`s_k` are the strides of the non-contracted and contracted axes, `n_other`/`n_k` their
+/// extents. A degenerate axis (extent 1) is free to take: it contributes no address variation, so
+/// following the other axis is coalesced whatever its stride happens to be.
+fn lane_axis(s_other: isize, s_k: isize, n_other: usize, n_k: usize) -> Option<LaneAxis> {
+    if s_k == 1 {
+        Some(LaneAxis::K)
+    } else if s_other == 1 {
+        Some(LaneAxis::Other)
+    } else if n_other == 1 {
+        Some(LaneAxis::K)
+    } else if n_k == 1 {
+        Some(LaneAxis::Other)
+    } else {
+        None
+    }
+}
+
+/// One attempt of the tiled driver.
+pub(super) fn run<TA, TB, TC, TBuf>(p: &Problem<'_, TA, TB, TC, TBuf>) -> Result<Verdict>
+where
+    TA: 'static,
+    TB: 'static,
+    TC: Copy + 'static,
+    TBuf: 'static,
+{
+    // the single-type kernel covers f32 and f64 only
+    if TypeId::of::<TC>() == TypeId::of::<f32>() {
+        return typed(p.uniform::<f32>(), p);
+    }
+    if TypeId::of::<TC>() == TypeId::of::<f64>() {
+        return typed(p.uniform::<f64>(), p);
+    }
+    Ok(Verdict::Declined(Refusal::Cannot("the single-type tiled kernel covers f32 and f64 only")))
+}
+
+/// Launch `c = alpha * a @ b + beta * c`, or decline with the reason. Errors are launch failures.
+///
+/// `c` is read by address only (its element type is `T` or `MaybeUninit<T>`), and it is not read
+/// at all on the device when `beta == 0`: that is the contract of `matmul_uninit`.
+fn typed<T: CudaDType, TA, TB, TC, TBuf>(
+    u: Option<Uniform<'_, T>>,
+    p: &Problem<'_, TA, TB, TC, TBuf>,
+) -> Result<Verdict> {
+    let Some(u) = u else {
+        return Ok(Verdict::Declined(Refusal::Cannot("the operands and the output must share one dtype")));
+    };
+    let geom = &p.geom;
+    let GemmGeom { m, n, k, n_batch, .. } = geom;
+    let (m, n, k, n_batch) = (*m, *n, *k, *n_batch);
+    let decline = |what: &'static str| Ok(Verdict::Declined(Refusal::Cannot(what)));
+
+    if m > i32::MAX as usize || n > i32::MAX as usize || k > i32::MAX as usize {
+        return decline("a dimension exceeds i32");
+    }
+    let grid_x = (n as u64).div_ceil(BN as u64);
+    let grid_y = (m as u64).div_ceil(BM as u64);
+    if grid_y > u16::MAX as u64 || n_batch as u64 > u16::MAX as u64 {
+        return decline("more than 65535 row tiles or batch slices (the grid limit on y and z)");
+    }
+    // Batch: one grid slice per output matrix, so the batch offset must be affine.
+    if geom.affine_batch().is_none() {
+        return decline("the batch part is not one linear run (grid.z carries an affine batch only)");
+    }
+    let [sa_b, sb_b, sc_b] = geom.affine_batch().unwrap_or([0; 3]);
+    let (a_off, sam, sak) = geom.a;
+    let (b_off, sbk, sbn) = geom.b;
+    let (c_off, scm, scn) = geom.c;
+    // An operand with no unit-stride axis: the lanes have nothing to follow.
+    let Some(lane_a) = lane_axis(sam, sak, m, k) else {
+        return decline("an operand has no unit-stride axis (strides of the left operand)");
+    };
+    let Some(lane_b) = lane_axis(sbn, sbk, n, k) else {
+        return decline("the right operand has no unit-stride axis");
+    };
+
+    let exec = p.device.stream();
+    let (buf_a, buf_b) = if geom.swapped { (u.b, u.a) } else { (u.a, u.b) };
+    let _ga = order_input(buf_a, exec)?;
+    let _gb = order_input(buf_b, exec)?;
+    let _gc = order_output(u.c, exec)?;
+
+    // The two fragments differ only in which axis the linear id follows; that is what makes each
+    // variant coalesced on both operands' loads.
+    let a_idx = match lane_a {
+        LaneAxis::K => "rstsr_usz kk = lin % @BK@; rstsr_usz mm = lin / @BK@;",
+        LaneAxis::Other => "rstsr_usz mm = lin % @BM@; rstsr_usz kk = lin / @BM@;",
+    };
+    let b_idx = match lane_b {
+        LaneAxis::K => "rstsr_usz kk = lin % @BK@; rstsr_usz nn = lin / @BK@;",
+        LaneAxis::Other => "rstsr_usz nn = lin % @BN@; rstsr_usz kk = lin / @BN@;",
+    };
+
+    // Order matters: the fragments are text that still contains the numeric tokens, so they must be
+    // expanded *before* the numbers, or an `@BK@` inside a fragment survives into the CUDA source.
+    let subs: Vec<(&str, String)> = vec![
+        ("@A_IDX@", a_idx.to_string()),
+        ("@B_IDX@", b_idx.to_string()),
+        ("@T@", T::CNAME.to_string()),
+        ("@BM@", BM.to_string()),
+        ("@BN@", BN.to_string()),
+        ("@BK@", BK.to_string()),
+        ("@TM@", TM.to_string()),
+        ("@TN@", TN.to_string()),
+        ("@TX@", TX.to_string()),
+        ("@TY@", TY.to_string()),
+        ("@NTHREADS@", NTHREADS.to_string()),
+        ("@A_SLAB@", A_SLAB.to_string()),
+        ("@B_SLAB@", B_SLAB.to_string()),
+    ];
+    let subs: Vec<(&str, &str)> = subs.iter().map(|(k, v)| (*k, v.as_str())).collect();
+
+    // The discriminator must name every substitution the source depends on, or two variants collide
+    // in the cache and one launches the other's code.
+    let disc = format!(
+        "{}|{}|{}|BM{BM}|BN{BN}|BK{BK}|TM{TM}|TN{TN}|N{NTHREADS}",
+        T::CNAME,
+        match lane_a {
+            LaneAxis::K => "ak",
+            LaneAxis::Other => "am",
+        },
+        match lane_b {
+            LaneAxis::K => "bk",
+            LaneAxis::Other => "bn",
+        },
+    );
+    let f = planned_function(p.device, "rstsr_gemm", T::INCLUDES, &disc, || render(GEMM_ENTRY, &subs))?;
+
+    let nb = core::mem::size_of::<T>();
+    let abytes = super::scalar_bytes(&u.alpha);
+    let bbytes = super::scalar_bytes(&u.beta);
+
+    FlatLaunch::new(exec, &f, 0)
+        .explicit_shape((grid_x as u32, grid_y as u32, n_batch as u32), (TX, TY, 1))
+        .arg_ptr(u.c, c_off)
+        .arg_bytes(&scm.to_ne_bytes())
+        .arg_bytes(&scn.to_ne_bytes())
+        .arg_bytes(&sc_b.to_ne_bytes())
+        .arg_ptr(buf_a, a_off)
+        .arg_bytes(&sam.to_ne_bytes())
+        .arg_bytes(&sak.to_ne_bytes())
+        .arg_bytes(&sa_b.to_ne_bytes())
+        .arg_ptr(buf_b, b_off)
+        .arg_bytes(&sbk.to_ne_bytes())
+        .arg_bytes(&sbn.to_ne_bytes())
+        .arg_bytes(&sb_b.to_ne_bytes())
+        .arg_i32(m as i32)
+        .arg_i32(n as i32)
+        .arg_i32(k as i32)
+        .arg_bytes(&abytes[..nb])
+        .arg_bytes(&bbytes[..nb])
+        .launch()?;
+
+    Ok(Verdict::Ran)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// The lane map prefers the unit-stride axis, and falls back to the axis that actually varies
+    /// when the other is degenerate.
+    #[test]
+    fn lane_axis_prefers_the_unit_stride() {
+        assert!(matches!(lane_axis(64, 1, 64, 64), Some(LaneAxis::K)));
+        assert!(matches!(lane_axis(1, 64, 64, 64), Some(LaneAxis::Other)));
+        // [1, K] with a strided k axis: nothing is unit-stride, but m is degenerate, so following
+        // k is still the right map.
+        assert!(matches!(lane_axis(0, 2, 1, 64), Some(LaneAxis::K)));
+        // genuinely stepped on both axes
+        assert!(lane_axis(2, 64, 64, 64).is_none());
+    }
+
+    /// Tile geometry has to stay self-consistent: the kernel derives slab counts from it and the
+    /// shared arrays from `BM`/`BN`.
+    #[test]
+    fn tile_geometry_is_consistent() {
+        assert_eq!(TX * TY, NTHREADS);
+        assert_eq!(TM * TY, BM);
+        assert_eq!(TN * TX, BN);
+        assert_eq!(BM * BK, A_SLAB * NTHREADS);
+        assert_eq!(BK * BN, B_SLAB * NTHREADS);
+        // static shared memory for both slabs must fit the 48 KB static limit
+        let smem = (BK * (BM + 1) + BK * (BN + 1)) * 8;
+        assert!(smem <= 48 * 1024, "static shared memory {smem} B is over the 48 KB limit");
+    }
+}
diff --git a/crates-device/rstsr-cuda/src/matmul/flags.rs b/crates-device/rstsr-cuda/src/matmul/flags.rs
new file mode 100644
index 0000000..9b7dae6
--- /dev/null
+++ b/crates-device/rstsr-cuda/src/matmul/flags.rs
@@ -0,0 +1,145 @@
+//! The driver enable set of the matmul chain.
+
+use core::fmt;
+use std::ops::{BitOr, BitOrAssign, Sub, SubAssign};
+
+use super::drivers::GemmDriver;
+
+/// The matmul drivers a device may use ([`CudaRuntimeFlags::matmul_drivers`]).
+///
+/// [`CudaRuntimeFlags::matmul_drivers`]: crate::flags::CudaRuntimeFlags::matmul_drivers
+///
+/// Selection is the static candidate table of the type triple, filtered by this set. Forcing one
+/// driver is enabling only its bit; an empty set, or a set none of whose members can serve the
+/// triple, is an error naming the drivers and the triple.
+#[derive(Clone, Copy, PartialEq, Eq, Hash)]
+#[non_exhaustive]
+pub struct MatMulDrivers(u8);
+
+impl Default for MatMulDrivers {
+    /// Every driver.
+    fn default() -> Self {
+        Self::all()
+    }
+}
+
+impl MatMulDrivers {
+    pub const CUBLAS_LT: Self = GemmDriver::CublasLt.flag();
+    pub const CUBLAS_EX: Self = GemmDriver::CublasEx.flag();
+    pub const CUBLAS: Self = GemmDriver::Cublas.flag();
+    pub const TILED: Self = GemmDriver::Tiled.flag();
+    pub const NAIVE: Self = GemmDriver::Naive.flag();
+
+    /// The set of one raw bit pattern ([`GemmDriver::flag`] builds the named constants).
+    pub(crate) const fn from_bits(bits: u8) -> Self {
+        Self(bits)
+    }
+
+    /// Every driver.
+    pub const fn all() -> Self {
+        Self(0b11111)
+    }
+
+    /// No driver.
+    pub const fn none() -> Self {
+        Self(0)
+    }
+
+    /// Whether every driver of `other` is enabled here.
+    pub const fn contains(self, other: Self) -> bool {
+        self.0 & other.0 == other.0
+    }
+
+    /// The union of two sets.
+    pub const fn union(self, other: Self) -> Self {
+        Self(self.0 | other.0)
+    }
+
+    /// Every driver of `self` that is not in `other` (`all().minus(X)` disables `X`).
+    pub const fn minus(self, other: Self) -> Self {
+        Self(self.0 & !other.0)
+    }
+
+    /// Whether no driver is enabled.
+    pub const fn is_empty(self) -> bool {
+        self.0 == 0
+    }
+}
+
+impl BitOr for MatMulDrivers {
+    type Output = Self;
+    fn bitor(self, rhs: Self) -> Self {
+        self.union(rhs)
+    }
+}
+
+impl BitOrAssign for MatMulDrivers {
+    fn bitor_assign(&mut self, rhs: Self) {
+        self.0 |= rhs.0;
+    }
+}
+
+impl Sub for MatMulDrivers {
+    type Output = Self;
+    fn sub(self, rhs: Self) -> Self {
+        self.minus(rhs)
+    }
+}
+
+impl SubAssign for MatMulDrivers {
+    fn sub_assign(&mut self, rhs: Self) {
+        self.0 &= !rhs.0;
+    }
+}
+
+impl fmt::Debug for MatMulDrivers {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        let names: Vec<&str> = GemmDriver::ALL.iter().filter(|d| self.contains(d.flag())).map(|d| d.name()).collect();
+        if names.is_empty() {
+            return write!(f, "MatMulDrivers(none)");
+        }
+        write!(f, "MatMulDrivers({})", names.join("|"))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// The five drivers own one bit each, and `all` is their union.
+    #[test]
+    fn one_bit_per_driver() {
+        let mut bits = Vec::new();
+        for d in GemmDriver::ALL {
+            assert_eq!(d.flag().0.count_ones(), 1, "{} must own exactly one bit", d.name());
+            assert!(!bits.contains(&d.flag().0), "{} shares a bit", d.name());
+            bits.push(d.flag().0);
+        }
+        let mut union = MatMulDrivers::none();
+        for d in GemmDriver::ALL {
+            union |= d.flag();
+        }
+        assert_eq!(union, MatMulDrivers::all());
+    }
+
+    /// `contains` is a subset test, so a forced driver is contained in its own set only.
+    #[test]
+    fn contains_is_a_subset_test() {
+        let tiled = MatMulDrivers::TILED;
+        assert!(MatMulDrivers::all().contains(tiled));
+        assert!(tiled.contains(tiled));
+        assert!(!tiled.contains(MatMulDrivers::NAIVE));
+        let without = MatMulDrivers::all() - MatMulDrivers::CUBLAS;
+        assert!(!without.contains(MatMulDrivers::CUBLAS));
+        assert!(without.contains(MatMulDrivers::TILED));
+    }
+
+    /// The default enables every driver; a forced set holds one name.
+    #[test]
+    fn default_and_display() {
+        assert_eq!(MatMulDrivers::default(), MatMulDrivers::all());
+        assert_eq!(format!("{:?}", MatMulDrivers::TILED | MatMulDrivers::NAIVE), "MatMulDrivers(tiled|naive)");
+        assert_eq!(format!("{:?}", MatMulDrivers::default()), "MatMulDrivers(cublasLt|cublasEx|cublas|tiled|naive)");
+        assert_eq!(format!("{:?}", MatMulDrivers::none()), "MatMulDrivers(none)");
+    }
+}
diff --git a/crates-device/rstsr-cuda/src/matmul/geom.rs b/crates-device/rstsr-cuda/src/matmul/geom.rs
new file mode 100644
index 0000000..2de549e
--- /dev/null
+++ b/crates-device/rstsr-cuda/src/matmul/geom.rs
@@ -0,0 +1,402 @@
+//! Geometry of one matmul problem, resolved from the layouts alone.
+//!
+//! [`resolve_geom`] is pure (no device, no allocation, no I/O), because this is the part that can
+//! be wrong in a way a GPU run reports only as "wrong numbers": the col-major reversal, the batch
+//! parts, which buffer plays which role. All of it is host-side arithmetic on strides, so it is
+//! tested here rather than on hardware.
+//!
+//! Nothing about a *driver's* restrictions lives here. The geometry describes every layout the
+//! rule table admits; each driver decides what it can express ([`super::drivers`]) and declines.
+
+use crate::prelude_dev::*;
+
+/// The batch part of one operand: per-axis extents and strides, in the row-major order of the
+/// rule table. Empty when the operand has no batch part.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub(crate) struct BatchPart {
+    pub shape: Vec<usize>,
+    pub stride: Vec<isize>,
+}
+
+impl BatchPart {
+    fn of(l: Option<&Layout<IxD>>) -> Self {
+        let Some(l) = l else { return Self::default() };
+        Self { shape: l.shape().to_vec(), stride: l.stride().to_vec() }
+    }
+
+    /// Number of batch slices (1 when there is no batch part).
+    pub fn size(&self) -> usize {
+        self.shape.iter().product()
+    }
+}
+
+/// Element step of one batch slice, if the batch part is a single affine run.
+///
+/// Size-1 axes are dropped first, because they contribute no offset however their stride is
+/// written: `[4, 1]` with strides `[3, 0]` steps by 3, and `[4, 1]` with `[3, 7]` steps by 3 as
+/// well. What survives must then be a row-major progression, so `offset = index * step` for every
+/// index in `0..size`. Broadcast axes (`stride == 0`) are affine with step 0, which covers
+/// `A[i,j] @ B[p,j,k]` where the batch axis belongs to `B` alone.
+///
+/// `None` means a genuinely strided multi-axis batch (`[4, 3]` with strides `[6, 1]`, whose offsets
+/// are not one step); only a driver that walks the batch axes one by one can take those.
+pub(crate) fn linear_step(part: &BatchPart) -> Option<isize> {
+    let mut shape = Vec::with_capacity(part.shape.len());
+    let mut stride = Vec::with_capacity(part.stride.len());
+    for k in 0..part.shape.len() {
+        if part.shape[k] != 1 {
+            shape.push(part.shape[k]);
+            stride.push(part.stride[k]);
+        }
+    }
+    if shape.is_empty() {
+        return Some(0);
+    }
+    let n = shape.len();
+    let step = stride[n - 1];
+    let mut expect = step;
+    for k in (0..n).rev() {
+        if stride[k] != expect {
+            return None;
+        }
+        expect *= shape[k] as isize;
+    }
+    Some(step)
+}
+
+/// Everything a driver needs to address the three buffers, resolved from the layouts alone.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct GemmGeom {
+    pub m: usize,
+    pub n: usize,
+    pub k: usize,
+    pub n_batch: usize,
+    /// `(element offset, stride of the m axis, stride of the k axis, batch part)` for the left
+    /// operand of the *row-major* problem, which under `ColMajor` is the caller's `b`.
+    pub a: (usize, isize, isize),
+    /// The same for the right operand: `(offset, stride of the k axis, stride of the n axis)`.
+    pub b: (usize, isize, isize),
+    /// `(offset, stride of the m axis, stride of the n axis)` for the output.
+    pub c: (usize, isize, isize),
+    /// The batch parts of `a`, `b`, `c` in the *geom* roles.
+    pub batch: [BatchPart; 3],
+    /// True when the geometry came from the col-major reversal, i.e. `a` and `b` are the caller's
+    /// second and first operands respectively.
+    pub swapped: bool,
+}
+
+/// The geometry in the caller's roles: `c[i, j] = sum_k a[i, k] * b[k, j]`, whatever the order.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct CallerGeom<'a> {
+    /// Extents `(m, k, n)` of the caller's problem.
+    pub mnk: (usize, usize, usize),
+    /// `(offset, stride of the m axis, stride of the k axis)` of the caller's `a`.
+    pub a: (usize, isize, isize),
+    /// `(offset, stride of the k axis, stride of the n axis)` of the caller's `b`.
+    pub b: (usize, isize, isize),
+    /// `(offset, stride of the m axis, stride of the n axis)` of the output.
+    pub c: (usize, isize, isize),
+    /// The batch parts of the caller's `a`, `b` and the output.
+    pub batch: [&'a BatchPart; 3],
+}
+
+impl GemmGeom {
+    /// The single element step of each batch part, or `None` if any is not one linear run.
+    pub fn affine_batch(&self) -> Option<[isize; 3]> {
+        Some([linear_step(&self.batch[0])?, linear_step(&self.batch[1])?, linear_step(&self.batch[2])?])
+    }
+
+    /// The same addresses, named by the caller's operands instead of the row-major roles.
+    ///
+    /// The col-major reversal only relabels axes: `geom`'s `(i, kk)` of its `a` is the caller's
+    /// `b[kk, i]`, and so on, so no address changes here, only which stride belongs to which name.
+    pub fn caller(&self) -> CallerGeom<'_> {
+        if self.swapped {
+            CallerGeom {
+                mnk: (self.n, self.k, self.m),
+                a: (self.b.0, self.b.2, self.b.1),
+                b: (self.a.0, self.a.2, self.a.1),
+                c: (self.c.0, self.c.2, self.c.1),
+                batch: [&self.batch[1], &self.batch[0], &self.batch[2]],
+            }
+        } else {
+            CallerGeom {
+                mnk: (self.m, self.k, self.n),
+                a: self.a,
+                b: self.b,
+                c: self.c,
+                batch: [&self.batch[0], &self.batch[1], &self.batch[2]],
+            }
+        }
+    }
+}
+
+/// Resolve the geometry of `c = a @ b` on the layout the tier already validated. Pure.
+pub(crate) fn resolve_geom(order: FlagOrder, lc: &Layout<IxD>, la: &Layout<IxD>, lb: &Layout<IxD>) -> Result<GemmGeom> {
+    // Col-major: reverse every layout **and swap the operands**, so the row-major decomposition of
+    // the problem is the one the rule table knows. That is the identity
+    // `rstsr_common::layout::matmul` documents, `C[n,m,t] = B[n,k,t] @ A[k,m,t]`, not a
+    // device-specific convention.
+    //
+    // The swap has to happen here, when asking for the config: reversing alone would feed the rule
+    // table `(A_rev, B_rev)`, whose contracted dimensions are `m_a` and `n_b` — a shape mismatch
+    // for anything rectangular, and a silently transposed answer for anything square.
+    let swapped = matches!(order, ColMajor);
+    let (la_c, lb_c, lc_c) = if swapped {
+        (lb.reverse_axes(), la.reverse_axes(), lc.reverse_axes())
+    } else {
+        (la.clone(), lb.clone(), lc.clone())
+    };
+
+    let cfg = layout_matmul_dyn_row_major_with_lc(&la_c, &lb_c, &lc_c)?;
+
+    // The inner-dot rule leaves `la_matmul` rank 1. That rule is a reduction, not a GEMM: no
+    // driver here is the reduce kernel, so it is refused by name.
+    if cfg.la_matmul.ndim() != 2 || cfg.lb_matmul.ndim() != 2 {
+        rstsr_raise!(
+            UnImplemented,
+            "cuda matmul: this is a single-axis contraction (inner dot), not a GEMM; it belongs on \
+             the reduce kernel and is not wired to it yet"
+        )?
+    }
+
+    let (lay_a, lay_b) = (&cfg.la_matmul, &cfg.lb_matmul);
+    let (m, k) = (lay_a.shape()[0], lay_a.shape()[1]);
+    let (k2, n) = (lay_b.shape()[0], lay_b.shape()[1]);
+    rstsr_assert_eq!(k, k2, InvalidLayout, "the contracted dimensions of a and b should be the same")?;
+    rstsr_assert_eq!(
+        cfg.lc_matmul.shape(),
+        &[m, n][..],
+        InvalidLayout,
+        "the matmul output should have shape (a.shape[0], b.shape[1])"
+    )?;
+
+    let batch =
+        [BatchPart::of(cfg.la_rest.as_ref()), BatchPart::of(cfg.lb_rest.as_ref()), BatchPart::of(cfg.lc_rest.as_ref())];
+
+    let sa = (lay_a.stride()[0], lay_a.stride()[1]);
+    let sb = (lay_b.stride()[0], lay_b.stride()[1]);
+    let sc = (cfg.lc_matmul.stride()[0], cfg.lc_matmul.stride()[1]);
+
+    Ok(GemmGeom {
+        m,
+        n,
+        k,
+        n_batch: batch[2].size(),
+        a: (lay_a.offset(), sa.0, sa.1),
+        b: (lay_b.offset(), sb.0, sb.1),
+        c: (cfg.lc_matmul.offset(), sc.0, sc.1),
+        batch,
+        swapped,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn layout(shape: &[usize], stride: &[isize]) -> Layout<IxD> {
+        Layout::<IxD>::new(shape.to_vec(), stride.to_vec(), 0).unwrap()
+    }
+
+    fn part(shape: &[usize], stride: &[isize]) -> BatchPart {
+        BatchPart { shape: shape.to_vec(), stride: stride.to_vec() }
+    }
+
+    /// A contiguous batch, a broadcast batch and a rank-1 batch are all affine.
+    #[test]
+    fn affine_batches_are_linear() {
+        fn lin(shape: &[usize], stride: &[isize]) -> Option<isize> {
+            linear_step(&part(shape, stride))
+        }
+        assert_eq!(lin(&[4], &[64]), Some(64));
+        assert_eq!(lin(&[4, 3], &[3, 1]), Some(1), "contiguous = step 1 over the flat index");
+        assert_eq!(lin(&[4], &[0]), Some(0), "broadcast");
+        assert_eq!(lin(&[4, 1], &[3, 0]), Some(3), "size-1 axes contribute nothing");
+        assert_eq!(lin(&[4, 3], &[0, 0]), Some(0), "all-broadcast");
+        assert_eq!(lin(&[], &[]), Some(0), "no batch at all");
+    }
+
+    /// A batch that walks two axes with a hole between them is not one step, and is refused.
+    #[test]
+    fn gapped_batches_are_refused() {
+        assert_eq!(linear_step(&part(&[4, 3], &[6, 1])), None);
+        assert_eq!(linear_step(&part(&[4, 3], &[9, 1])), None);
+    }
+
+    /// The offset a layout assigns to one multi-index. This is the tensor layer's own mapping, so
+    /// comparing the geom against it checks *which layout plays which role*, not the arithmetic of
+    /// `offset + i*stride` twice over.
+    fn off(l: &Layout<IxD>, idx: &[usize]) -> isize {
+        let mut o = l.offset() as isize;
+        for (k, &i) in idx.iter().enumerate() {
+            o += i as isize * l.stride()[k];
+        }
+        o
+    }
+
+    /// Row-major: `geom.a` walks `a[i, k]`, `geom.b` walks `b[k, j]`, `geom.c` walks `c[i, j]`.
+    #[test]
+    fn row_major_geom_matches_the_layouts() {
+        let (m, k, n) = (2usize, 3usize, 4usize);
+        let la = layout(&[m, k], &[k as isize, 1]);
+        let lb = layout(&[k, n], &[n as isize, 1]);
+        let lc = layout(&[m, n], &[n as isize, 1]);
+        let g = resolve_geom(RowMajor, &lc, &la, &lb).unwrap();
+
+        assert_eq!((g.m, g.n, g.k, g.n_batch), (m, n, k, 1));
+        assert!(!g.swapped);
+
+        for i in 0..m {
+            for kk in 0..k {
+                assert_eq!(g.a.0 as isize + i as isize * g.a.1 + kk as isize * g.a.2, off(&la, &[i, kk]));
+            }
+            for j in 0..n {
+                assert_eq!(g.c.0 as isize + i as isize * g.c.1 + j as isize * g.c.2, off(&lc, &[i, j]));
+            }
+        }
+        for kk in 0..k {
+            for j in 0..n {
+                assert_eq!(g.b.0 as isize + kk as isize * g.b.1 + j as isize * g.b.2, off(&lb, &[kk, j]));
+            }
+        }
+        // without a batch part every step is 0 and there is one slice
+        assert!(g.batch.iter().all(|p| p.shape.is_empty()));
+        assert_eq!(g.affine_batch(), Some([0, 0, 0]));
+    }
+
+    /// Column-major: the roles swap and every index is read in the other order. This is the case a
+    /// GPU run would report only as "wrong numbers", so it is pinned by walking each buffer and
+    /// comparing against the tensor layout's own offset.
+    #[test]
+    fn col_major_geom_swaps_roles_and_index_order() {
+        let (m, k, n) = (2usize, 3usize, 4usize);
+        // column-major = first axis contiguous
+        let la = layout(&[m, k], &[1, m as isize]);
+        let lb = layout(&[k, n], &[1, k as isize]);
+        let lc = layout(&[m, n], &[1, m as isize]);
+        let g = resolve_geom(ColMajor, &lc, &la, &lb).unwrap();
+
+        assert!(g.swapped, "col-major must then read the operands the other way round");
+        assert_eq!((g.m, g.n, g.k), (n, m, k), "the problem is solved transposed");
+        assert_eq!(g.m * g.n, m * n, "but it is still the same output matrix");
+
+        // geom.a is the caller's b, walked as b[k, n]: geom's (i, kk) is b's (kk, i)
+        for i in 0..g.m {
+            for kk in 0..g.k {
+                assert_eq!(g.a.0 as isize + i as isize * g.a.1 + kk as isize * g.a.2, off(&lb, &[kk, i]));
+            }
+        }
+        // geom.b is the caller's a, walked as a[m, k]: geom's (kk, j) is a's (j, kk)
+        for kk in 0..g.k {
+            for j in 0..g.n {
+                assert_eq!(g.b.0 as isize + kk as isize * g.b.1 + j as isize * g.b.2, off(&la, &[j, kk]));
+            }
+        }
+        // geom.c is c[n, m]: geom's (i, j) is c's (j, i)
+        for i in 0..g.m {
+            for j in 0..g.n {
+                assert_eq!(g.c.0 as isize + i as isize * g.c.1 + j as isize * g.c.2, off(&lc, &[j, i]));
+            }
+        }
+    }
+
+    /// A batched problem: the batch step must be the stride of one whole batched matrix, and a
+    /// broadcast operand must have step 0.
+    #[test]
+    fn batch_step_is_one_matrix() {
+        let (p, m, k, n) = (4usize, 5usize, 6usize, 7usize);
+        let la = layout(&[p, m, k], &[(m * k) as isize, k as isize, 1]);
+        let lb = layout(&[p, k, n], &[(k * n) as isize, n as isize, 1]);
+        let lc = layout(&[p, m, n], &[(m * n) as isize, n as isize, 1]);
+        let g = resolve_geom(RowMajor, &lc, &la, &lb).unwrap();
+        assert_eq!(g.n_batch, p);
+        assert_eq!(g.batch.iter().map(|b| b.shape.clone()).collect::<Vec<_>>(), vec![vec![p]; 3]);
+        assert_eq!(g.affine_batch(), Some([(m * k) as isize, (k * n) as isize, (m * n) as isize]));
+
+        // left operand broadcast over the batch: its batch part is absent, so its step is 0
+        let la1 = layout(&[m, k], &[k as isize, 1]);
+        let g1 = resolve_geom(RowMajor, &lc, &la1, &lb).unwrap();
+        assert_eq!(g1.n_batch, p);
+        assert_eq!(g1.batch[0].shape, vec![p], "a's batch part is broadcast to the output's");
+        assert_eq!(g1.batch[0].stride, vec![0]);
+        assert_eq!(g1.affine_batch(), Some([0, (k * n) as isize, (m * n) as isize]));
+    }
+
+    /// The inner-dot rule has no 2-D matmul part, and is refused rather than run as a 1x1 tile.
+    #[test]
+    fn inner_dot_has_no_geometry() {
+        let la = layout(&[6], &[1]);
+        let lc = layout(&[], &[]);
+        let e = resolve_geom(RowMajor, &lc, &la, &la).unwrap_err();
+        assert!(format!("{e}").contains("single-axis contraction"), "got: {e}");
+    }
+
+    /// The caller view undoes the col-major relabelling: every `(i, k)`, `(k, j)` and `(i, j)` of
+    /// the caller names the same element the caller's own layout does, in both orders.
+    #[test]
+    fn caller_view_addresses_the_callers_elements() {
+        let (p, m, k, n) = (3usize, 5usize, 6usize, 7usize);
+        for order in [RowMajor, ColMajor] {
+            // Contiguous in the order under test, with the batch axis where that order puts it:
+            // trailing under row-major, leading under col-major (the matrix axes are the two the
+            // order names first).
+            // row-major strides: the running product of the extents to the right
+            let contig = |shape: &[usize]| {
+                let mut run: isize = shape.iter().map(|&d| d as isize).product();
+                let stride: Vec<isize> = shape
+                    .iter()
+                    .map(|&d| {
+                        run /= d as isize;
+                        run
+                    })
+                    .collect();
+                layout(shape, &stride)
+            };
+            let f = |d0: usize, d1: usize, d2: usize| layout(&[d0, d1, d2], &[1, d0 as isize, (d0 * d1) as isize]);
+            let (la, lb, lc) = if matches!(order, RowMajor) {
+                (contig(&[p, m, k]), contig(&[p, k, n]), contig(&[p, m, n]))
+            } else {
+                (f(m, k, p), f(k, n, p), f(m, n, p))
+            };
+            let g = resolve_geom(order, &lc, &la, &lb).unwrap();
+            let v = g.caller();
+            assert_eq!(g.swapped, matches!(order, ColMajor));
+            assert_eq!(v.batch[0].shape, vec![p], "the batch parts follow the caller's names");
+            assert_eq!(v.mnk, (m, k, n), "and so do the extents");
+            // the caller's multi-index of `(x, y)` of an operand: batch axis last or first
+            let idx = |x: usize, y: usize| {
+                if matches!(order, RowMajor) {
+                    vec![0, x, y]
+                } else {
+                    vec![x, y, 0]
+                }
+            };
+            for i in 0..m {
+                for kk in 0..k {
+                    assert_eq!(
+                        v.a.0 as isize + i as isize * v.a.1 + kk as isize * v.a.2,
+                        off(&la, &idx(i, kk)),
+                        "{order:?}: a[{i},{kk}]"
+                    );
+                }
+                for j in 0..n {
+                    assert_eq!(
+                        v.c.0 as isize + i as isize * v.c.1 + j as isize * v.c.2,
+                        off(&lc, &idx(i, j)),
+                        "{order:?}: c[{i},{j}]"
+                    );
+                }
+            }
+            for kk in 0..k {
+                for j in 0..n {
+                    assert_eq!(
+                        v.b.0 as isize + kk as isize * v.b.1 + j as isize * v.b.2,
+                        off(&lb, &idx(kk, j)),
+                        "{order:?}: b[{kk},{j}]"
+                    );
+                }
+            }
+        }
+    }
+}
diff --git a/crates-device/rstsr-cuda/src/matmul/inner.rs b/crates-device/rstsr-cuda/src/matmul/inner.rs
new file mode 100644
index 0000000..99c6a21
--- /dev/null
+++ b/crates-device/rstsr-cuda/src/matmul/inner.rs
@@ -0,0 +1,99 @@
+//! The device entries: the inner function the drivers are dispatched from, and `DeviceMatMulAPI`.
+
+use crate::matmul::drivers::{self, NaiveScalar, Problem};
+use crate::matmul::geom::resolve_geom;
+use crate::matmul::mode::CudaMatMulMode;
+use crate::prelude_dev::*;
+
+/// `c = alpha * (a @ b) + beta * c`, with the compute `mode` of the output type given by the
+/// caller instead of read from the device flags.
+///
+/// `c` is the output buffer: `TC` for the `beta` path, `MaybeUninit<TC>` for the fresh one. With
+/// `beta == 0` it is never read, which is the whole of the `matmul_uninit` contract.
+///
+/// The drivers are tried in the chain order, filtered by `flags.matmul_drivers`; the first one
+/// that takes the problem runs it, and an error is returned only when none did.
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn matmul_with_mode_inner<TA, TB, TC, DA, DB, DC, TBuf>(
+    device: &DeviceCuda,
+    c: &CudaBuffer<TBuf>,
+    lc: &Layout<DC>,
+    a: &CudaBuffer<TA>,
+    la: &Layout<DA>,
+    b: &CudaBuffer<TB>,
+    lb: &Layout<DB>,
+    alpha: TC,
+    beta: TC,
+    mode: <TC as CudaMatMulMode>::Mode,
+) -> Result<()>
+where
+    DA: DimAPI,
+    DB: DimAPI,
+    DC: DimAPI,
+    TA: NaiveScalar,
+    TB: NaiveScalar,
+    TC: NaiveScalar + CudaMatMulMode,
+    TBuf: 'static,
+{
+    let geom = resolve_geom(device.default_order(), &lc.to_dim::<IxD>()?, &la.to_dim::<IxD>()?, &lb.to_dim::<IxD>()?)?;
+    if geom.m == 0 || geom.n == 0 || geom.n_batch == 0 {
+        return Ok(());
+    }
+    let problem = Problem {
+        device,
+        geom,
+        c,
+        a,
+        b,
+        alpha,
+        beta,
+        // `beta == 0` means "do not read c": the `MaybeUninit` slots are written, never touched.
+        read_c: !beta.is_zero(),
+    };
+    drivers::dispatch(&problem, &device.flags(), &mode)
+}
+
+impl<TA, TB, TC, DA, DB, DC> DeviceMatMulAPI<TA, TB, TC, DA, DB, DC> for DeviceCuda
+where
+    DA: DimAPI,
+    DB: DimAPI,
+    DC: DimAPI,
+    Self: DeviceRawAPI<TA, Raw = CudaBuffer<TA>>
+        + DeviceRawAPI<TB, Raw = CudaBuffer<TB>>
+        + DeviceRawAPI<TC, Raw = CudaBuffer<TC>>
+        + DeviceRawAPI<MaybeUninit<TC>, Raw = CudaBuffer<MaybeUninit<TC>>>,
+    // Every triple is accepted: the accelerated drivers serve the ones they can, the naive driver
+    // takes the rest (integers, complex, half, mixed operands).
+    TA: NaiveScalar,
+    TB: NaiveScalar,
+    TC: NaiveScalar + CudaMatMulMode,
+{
+    fn matmul(
+        &self,
+        c: &mut CudaBuffer<TC>,
+        lc: &Layout<DC>,
+        a: &CudaBuffer<TA>,
+        la: &Layout<DA>,
+        b: &CudaBuffer<TB>,
+        lb: &Layout<DB>,
+        alpha: TC,
+        beta: TC,
+    ) -> Result<()> {
+        let mode = TC::matmul_mode(&self.flags());
+        matmul_with_mode_inner(self, c, lc, a, la, b, lb, alpha, beta, mode)
+    }
+
+    fn matmul_uninit(
+        &self,
+        c: &mut CudaBuffer<MaybeUninit<TC>>,
+        lc: &Layout<DC>,
+        a: &CudaBuffer<TA>,
+        la: &Layout<DA>,
+        b: &CudaBuffer<TB>,
+        lb: &Layout<DB>,
+        alpha: TC,
+    ) -> Result<()> {
+        let mode = TC::matmul_mode(&self.flags());
+        matmul_with_mode_inner(self, c, lc, a, la, b, lb, alpha, <TC as num::Zero>::zero(), mode)
+    }
+}
