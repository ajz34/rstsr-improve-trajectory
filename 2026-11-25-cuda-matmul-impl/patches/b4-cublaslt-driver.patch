+pub(crate) fn with_gemm_call<T, TA, TB, TC, TBuf, F>(
+    u: &Uniform<'_, T>,
+    p: &Problem<'_, TA, TB, TC, TBuf>,
+    f: F,
+) -> Result<Verdict>
