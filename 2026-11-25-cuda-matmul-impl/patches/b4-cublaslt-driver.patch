+{
+    let call = match prepare(u, p)? {
+        Ok(call) => call,
+        Err(r) => return Ok(Verdict::Declined(r)),
+    };
+    let Some(blas) = call.exec.cublas() else {
+        return Ok(Verdict::Declined(Refusal::NoCublas));
