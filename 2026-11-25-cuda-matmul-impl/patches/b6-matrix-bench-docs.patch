diff --git a/crates-device/rstsr-cuda/tests/test_matmul_modes.rs b/crates-device/rstsr-cuda/tests/test_matmul_modes.rs
index 8534f57..97b4207 100644
--- a/crates-device/rstsr-cuda/tests/test_matmul_modes.rs
