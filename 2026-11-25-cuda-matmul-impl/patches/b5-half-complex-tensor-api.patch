+    let all = [MatMulDrivers::CUBLAS_LT, MatMulDrivers::CUBLAS_EX, MatMulDrivers::CUBLAS, MatMulDrivers::all()];
+    all.into_iter().filter(move |f| classic_serves_pedantic || *f != MatMulDrivers::CUBLAS)
+}
