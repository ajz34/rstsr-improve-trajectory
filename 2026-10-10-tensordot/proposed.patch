+        //     np.tensordot(a, b, axes=([1, 1], [0, 0]))
+        let a: Tensor<f64, _> = rt::ones(([2, 3, 3], &device));
+        let b: Tensor<f64, _> = rt::ones(([3, 3, 4], &device));
+        assert!(rt::tensordot_f(&a, &b, (vec![1, 1], vec![0, 0])).is_err());
