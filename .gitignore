# Gitignore for rstsr-improve-trajectory.
# Rust/Python blocks follow the main rstsr repo; deviations are marked.

# >>> IDE and configuration files <<< #

.vscode
.idea
lcov.info
.cargo

# >>> Temporary files <<< #

tmp*
tmp
profile
tarpaulin-report.html
/coverage/
book
*.npy
repomix-output*

# >>> Bindgen <<< #

blas_bindgen.h

# >>> Python <<< #

.ipynb_checkpoints/
__pycache__/
*.pyc

# >>> Rust/Cargo <<< #

# will have compiled files and executables
debug/
target/
build/

# Deviation from rstsr: Cargo.lock IS committed here.
# This repo holds executables/benchmarks, and lockfiles make recorded
# benchmark numbers reproducible.

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# >>> Code Agent <<< #

# Deviation from rstsr: .claude/, CLAUDE.md and AGENTS.md are COMMITTED here —
# this repository owns its agent configuration (unlike rstsr, which symlinks
# them from rstsr-agents and ignores them).

# Local agent/tool state (not shared)
.claude.json
.codex

# Aider chat history & caches
.aider*

# Cursor / Continue / Roo local state
.cursor/
.continue/
.roo/

# Catch-all for local-only files (e.g. *.local.toml, *.local.md)
*.local*

# criterion HTML/SVG report artifacts (bulky; raw JSON + txt outputs are kept)
**/criterion/**/report/
